---
import { formatName, uiTranslations } from '../utils/pokemon';
import TierLegend from './TierLegend.astro';
import type { SmogonSet } from '../services/smogon';

interface Props {
    pokemonName: string;
    lang: string;
    showdownData?: { tier?: string; abilities?: Record<string, string> } | null;
    smogonSets?: SmogonSet[] | null;
}

const { pokemonName, lang = 'es', showdownData = null, smogonSets = null } = Astro.props;
const t = uiTranslations[lang] || uiTranslations.es;

// Pre-compute tier and ability names in SSR when showdownData is available
const ssrTier = showdownData?.tier ?? null;
const ssrAbilities = showdownData?.abilities ? Object.entries(showdownData.abilities).map(([key, name]) => ({ key, name: name as string })) : null;
---

<div class="mt-12 bg-white dark:bg-slate-800 rounded-[3rem] border border-slate-100 dark:border-slate-700 shadow-xl p-8 md:p-12 transition-colors overflow-hidden relative">
    <div class="absolute -top-12 -right-12 w-48 h-48 bg-emerald-400/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="flex items-center gap-4 mb-10">
        <div class="p-3 bg-emerald-100 dark:bg-emerald-900/30 rounded-2xl text-emerald-600 dark:text-emerald-400" aria-hidden="true">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        </div>
        <div>
            <h3 class="text-sm font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em]">{t.comp_analysis}</h3>
            <p class="text-2xl font-black text-slate-900 dark:text-white">Smogon Tier & Meta</p>
        </div>
    </div>

    <div id="competitive-content"
         class="space-y-10"
         data-pokemon={pokemonName.toLowerCase().replace(/[^a-z0-9]/g, '')}
         data-lang={lang}
         data-ssr-tier={ssrTier ?? ''}
         data-ssr-abilities={ssrAbilities ? JSON.stringify(ssrAbilities.map(a => a.name)) : ''}>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 animate-pulse">
            <div class="h-32 bg-slate-100 dark:bg-slate-700/50 rounded-3xl"></div>
            <div class="h-32 bg-slate-100 dark:bg-slate-700/50 rounded-3xl"></div>
        </div>
    </div>

    {smogonSets && smogonSets.length > 0 && (
        <div class="mt-10 border-t border-slate-100 dark:border-slate-700 pt-10">
            <p class="text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-6">{t.comp_sets}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {smogonSets.map(set => (
                    <div class="bg-slate-50 dark:bg-slate-900/40 rounded-2xl p-5 border border-slate-100 dark:border-slate-700/50">
                        <p class="text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest mb-3">{set.name}</p>
                        <ul class="space-y-1 mb-3">
                            {set.moves.map(move => (
                                <li class="flex items-center gap-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0" aria-hidden="true"></span>
                                    {move}
                                </li>
                            ))}
                        </ul>
                        <div class="flex flex-wrap gap-2 mt-3 pt-3 border-t border-slate-100 dark:border-slate-700/50">
                            {set.item && <span class="text-[10px] font-bold bg-amber-100 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400 px-2 py-0.5 rounded-lg">{t.comp_sets_item}: {set.item}</span>}
                            {set.ability && <span class="text-[10px] font-bold bg-blue-100 dark:bg-blue-900/20 text-blue-700 dark:text-blue-400 px-2 py-0.5 rounded-lg">{t.comp_sets_ability}: {set.ability}</span>}
                            {set.nature && <span class="text-[10px] font-bold bg-violet-100 dark:bg-violet-900/20 text-violet-700 dark:text-violet-400 px-2 py-0.5 rounded-lg">{t.comp_sets_nature}: {set.nature}</span>}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    )}

    <TierLegend lang={lang} />
</div>

<script is:inline define:vars={{ uiTranslations }}>
    const abilityCache = new Map();

    function escHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    async function getAbilityInfo(abilityName, lang) {
        const slug = abilityName.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
        if (abilityCache.has(slug)) return abilityCache.get(slug);

        let name = abilityName;
        let desc = "";

        try {
            const res = await fetch(`https://pokeapi.co/api/v2/ability/${slug}`, { signal: AbortSignal.timeout(5000) });
            if (res.ok) {
                const data = await res.json();
                name = data.names.find(n => n.language.name === lang)?.name ||
                       data.names.find(n => n.language.name === 'es')?.name || name;

                const entry = data.flavor_text_entries.find(f => f.language.name === lang) ||
                             data.flavor_text_entries.find(f => f.language.name === 'es') ||
                             data.flavor_text_entries.find(f => f.language.name === 'en');

                if (entry) {
                    desc = entry.flavor_text;
                } else {
                    const effect = data.effect_entries.find(e => e.language.name === lang) ||
                                 data.effect_entries.find(e => e.language.name === 'en');
                    desc = effect ? effect.short_effect : "";
                }
            }
        } catch (e) {}

        if (!desc) desc = lang === 'es' ? "Descripción no disponible." : "Description not available.";

        const result = { name, desc: desc.replace(/\f/g, ' ') };
        abilityCache.set(slug, result);
        return result;
    }

    async function renderCompetitive(container, tier, rawAbilityNames, lang) {
        const t = uiTranslations[lang] || uiTranslations.es;

        if (!rawAbilityNames || rawAbilityNames.length === 0) {
            container.textContent = t.comp_no_abilities;
            return;
        }

        const abilitiesInfo = await Promise.all(rawAbilityNames.map(name => getAbilityInfo(name, lang)));

        const tierEl = document.createElement('span');
        tierEl.className = 'text-3xl font-black text-slate-900 dark:text-white tracking-tighter';
        tierEl.textContent = tier;

        const abilitiesText = abilitiesInfo.map(a => a.name).join(', ');
        const metaDescTemplate = t.comp_meta_desc
            .replace('{tier}', escHtml(tier))
            .replace('{abilities}', `<span class="text-emerald-600 dark:text-emerald-400">${escHtml(abilitiesText)}</span>`);

        const pokemon = container.dataset.pokemon;

        container.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-6">
                    <div>
                        <p class="text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-3">${escHtml(t.comp_usage)}</p>
                        <div class="inline-flex items-center gap-4 bg-slate-50 dark:bg-slate-900/50 px-6 py-3 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-inner">
                            <span class="w-4 h-4 rounded-full bg-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.6)] animate-pulse" aria-hidden="true"></span>
                            <span class="text-3xl font-black text-slate-900 dark:text-white tracking-tighter">${escHtml(tier)}</span>
                        </div>
                    </div>
                    <div class="bg-emerald-50 dark:bg-emerald-950/20 p-6 rounded-[2rem] border border-emerald-100/50 dark:border-emerald-900/20">
                        <p class="text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest mb-3">${escHtml(t.comp_meta)}</p>
                        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed font-medium">${metaDescTemplate}</p>
                        <a href="https://www.smogon.com/dex/sv/pokemon/${escHtml(pokemon)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-5 bg-white dark:bg-slate-900 px-4 py-2 rounded-xl text-emerald-600 dark:text-emerald-400 font-bold text-xs shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all border border-emerald-100 dark:border-emerald-900/30">
                            ${escHtml(t.comp_smogon_link)}
                            <svg class="w-3 h-3" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                        </a>
                    </div>
                </div>
                <div class="space-y-4">
                    <p class="text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest px-2">${escHtml(t.comp_effects)}</p>
                    <div class="space-y-3">
                        ${abilitiesInfo.map(a => `
                            <div class="bg-slate-50 dark:bg-slate-900/40 p-5 rounded-2xl border border-slate-100 dark:border-slate-700/50 group hover:border-emerald-200 dark:hover:border-emerald-800 transition-colors">
                                <p class="text-sm font-black text-slate-800 dark:text-white mb-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">${escHtml(a.name)}</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed italic font-medium">${escHtml(a.desc)}</p>
                            </div>
                        `).join('')}
                    </div>
                </div>
            </div>
        `;
    }

    async function loadCompetitiveData() {
        const container = document.getElementById('competitive-content');
        if (!container) return;

        const pokemon = container.dataset.pokemon;
        const lang = container.dataset.lang;
        const t = uiTranslations[lang] || uiTranslations.es;

        // Use SSR-provided data when available to avoid client-side Smogon JSON download
        const ssrTier = container.dataset.ssrTier;
        const ssrAbilitiesRaw = container.dataset.ssrAbilities;

        try {
            if (ssrTier && ssrAbilitiesRaw) {
                const rawAbilityNames = JSON.parse(ssrAbilitiesRaw);
                await renderCompetitive(container, ssrTier || 'Untiered', rawAbilityNames, lang);
                return;
            }

            // Fallback: fetch Smogon JSON in client (only if SSR data not available)
            if (!window.psPokedex) {
                const res = await fetch('https://play.pokemonshowdown.com/data/pokedex.json', { signal: AbortSignal.timeout(8000) });
                if (!res.ok) throw new Error('Failed to fetch Pokedex');
                window.psPokedex = await res.json();
            }

            const data = window.psPokedex[pokemon];
            if (!data) {
                container.textContent = t.comp_no_data;
                return;
            }

            const tier = data.tier || 'Untiered';
            const rawAbilityNames = data.abilities ? Object.values(data.abilities) : [];
            await renderCompetitive(container, tier, rawAbilityNames, lang);
        } catch (e) {
            container.textContent = t.comp_error;
        }
    }

    // Guard against duplicate listeners from is:inline re-execution on View Transitions
    if (!window._competitiveSetsInitialized) {
        window._competitiveSetsInitialized = true;
        document.addEventListener('astro:page-load', loadCompetitiveData);
    }
    loadCompetitiveData();
</script>
