---
// src/components/Breadcrumbs.astro
//
// Reusable breadcrumb trail: visible nav + BreadcrumbList JSON-LD. The last
// item is the current page and deliberately has no href/url — that's valid
// per schema.org's BreadcrumbList (Google's own examples omit it too).
import { canonicalUrl } from '../utils/seo';

interface Crumb {
    label: string;
    href?: string;
}

interface Props {
    items: Crumb[];
}

const { items } = Astro.props;

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.label,
        ...(item.href ? { item: canonicalUrl(item.href) } : {}),
    })),
};
---

<nav aria-label="breadcrumb" class="mb-8 flex flex-wrap items-center gap-2 text-[10px] font-black uppercase tracking-widest text-slate-400 dark:text-slate-500">
    {items.map((item, i) => (
        <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {item.href ? (
                <a href={item.href} class="hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors">{item.label}</a>
            ) : (
                <span class="text-slate-600 dark:text-slate-300" aria-current="page">{item.label}</span>
            )}
        </>
    ))}
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
