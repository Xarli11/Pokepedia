---
import { uiTranslations } from '../utils/pokemon';
import { buildPokeStudioUrl } from '../utils/ecosystem';
import TierLegend from './TierLegend.astro';

// Factual, attributed Smogon tier. Sets, ability blurbs and strategy links
// belong to PokeStudio, not to an encyclopedia page (docs/DATA_SOURCES.md).
// 100% server-rendered: no client script, no client fetches.
interface Props {
    pokemonName: string;
    lang: string;
    tier?: string | null;
}

const { pokemonName, lang = 'es', tier = null } = Astro.props;
const t = uiTranslations[lang] || uiTranslations.es;
const studioUrl = buildPokeStudioUrl(pokemonName);
---

{tier && (
    <section class="mt-12 bg-white dark:bg-slate-800 rounded-[2rem] border border-slate-100 dark:border-slate-700 shadow-sm p-6 md:p-8 transition-colors" aria-labelledby="smogon-tier-heading" data-smogon-tier={tier}>
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h3 id="smogon-tier-heading" class="text-sm font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em]">{t.tier_title}</h3>
                <p class="text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest mt-1">{t.source_competitive}</p>
            </div>
            <div class="inline-flex items-center gap-4 bg-slate-50 dark:bg-slate-900/50 px-6 py-3 rounded-2xl border border-slate-100 dark:border-slate-700 shadow-inner">
                <span class="w-3 h-3 rounded-full bg-emerald-500" aria-hidden="true"></span>
                <span class="text-3xl font-black text-slate-900 dark:text-white tracking-tighter">{tier}</span>
            </div>
        </div>
        <details class="mt-6">
            <summary class="cursor-pointer text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest">{t.tier_legend}</summary>
            <TierLegend lang={lang} />
        </details>
        {studioUrl && (
            <a href={studioUrl} target="_blank" rel="noopener noreferrer" data-track-event="cross_site_click" data-track-target="pokestudio" data-source-surface="pokemon_detail" class="inline-block mt-6 text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">{t.view_on_pokestudio}</a>
        )}
    </section>
)}
