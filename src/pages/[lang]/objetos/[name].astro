---
import Layout from '../../../layouts/Layout.astro';
import PokemonCard from '../../../components/PokemonCard.astro';
import ReportDataIssue from '../../../components/ReportDataIssue.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getLocalizedName, getItemDetail, getMachineMove, getPokemonListByUrls } from '../../../services/pokeapi';
import { selectItemEffect, selectItemFlavor } from '../../../utils/items';
import { uiTranslations, formatName, itemTranslations, getItemSuperCategory, typeTranslations } from '../../../utils/pokemon';
import { pagePath } from '../../../utils/seo';
import { buildItemTitle, resolveItemDescription, machineKind, pickLatestMachine, machineVersionLabel, teraShardType, type ItemFacts } from '../../../utils/itemMeta';
import { itemRobots } from '../../../utils/itemIndexing';

const { lang, name } = Astro.params;

// Only this primary lookup can 404 the page (EntityNotFoundError). An
// UpstreamError or a missing related resource is answered 503 by
// src/middleware.ts; any other error surfaces as a real 500.
const itemData = await getItemDetail((name as string).toLowerCase());

// PokeAPI resolves numeric ids and any casing (/211/, /Leftovers/ -> leftovers), which
// made each of those a second 200 page. Only the canonical slug renders.
if (name !== itemData.name) {
    return Astro.redirect(pagePath(lang as string, 'objetos', itemData.name), 301);
}

const localizedName = getLocalizedName(itemData.names, lang as string) || formatName(itemData.name);
const i18nItems = itemTranslations[lang as string] || itemTranslations.es;

// P0 #9: effect_entries (mechanics) is the primary, canonical description.
// flavor_text_entries (in-game flavor) is secondary and must never be
// presented as the exact mechanical effect — see src/utils/items.ts for why.
// Placeholder text ("[VAR (0000)]", "Unknown.", "XXX new effect…") never gets here.
const effect = selectItemEffect(itemData.effect_entries, lang as string);
const flavor = selectItemFlavor(itemData.flavor_text_entries, lang as string);
const categoryKey = itemData.category?.name;
const superCategoryKey = getItemSuperCategory(categoryKey || '');
const categoryName = i18nItems[superCategoryKey] || i18nItems[categoryKey] || formatName(categoryKey || '---');

// TM / TR / HM: the move it teaches comes from the machine of the most recent
// version group (machines[0] is the oldest one and named a different move for
// most TMs). Two requests at most (machine + move), same as before.
let moveDetail: { name: string; url: string; versionLabel: string | null } | null = null;
const latestMachine = pickLatestMachine(itemData.machines as { machine: { url: string }; version_group: { name: string } }[] | undefined);
if (latestMachine) {
    const moveData = await getMachineMove(latestMachine.machine.url);
    if (moveData) {
        moveDetail = {
            name: getLocalizedName(moveData.names, lang as string) || formatName(moveData.name),
            url: pagePath(lang as string, 'movimientos', moveData.name),
            versionLabel: machineVersionLabel(lang as string, latestMachine.version_group.name)
        };
    }
}
const isMachine = machineKind(itemData.name) !== null;
// A machine's own effect / flavor text can describe another generation's move.
// (only when the move can be stated together with its game, as the description does).
const showItemTexts = !(isMachine && moveDetail?.versionLabel);

// Tera Shard -> its type, from the "{type}-tera-shard" name (only for real Pokepedia types).
const teraType = teraShardType(itemData.name);
const teraTypeLabel = teraType ? typeTranslations[lang as string]?.[teraType] || null : null;

const localizedAttributes = (itemData.attributes || []).map((a: any) => i18nItems[a.name]).filter(Boolean) as string[];
const facts: ItemFacts = {
    name: localizedName,
    slug: itemData.name,
    categoryLabel: i18nItems[superCategoryKey] || i18nItems[categoryKey] || null,
    attributeLabels: localizedAttributes,
    flingPower: itemData.fling_power,
    cost: itemData.cost,
    teaches: moveDetail ? { moveName: moveDetail.name, versionLabel: moveDetail.versionLabel } : null,
    teraTypeLabel,
};
// Real text in the PAGE language (an English effect on a Spanish page is shown
// in the body with its notice, but never becomes the Spanish meta description).
const realText = (effect?.language === lang ? effect?.text : null) || (flavor?.language === lang ? flavor?.text : null);
const description = resolveItemDescription(lang as string, facts, showItemTexts ? realText : null);
const pageTitle = buildItemTitle(lang as string, facts);
const robots = itemRobots(itemData.name);

// Obtener detalles de Pokémon que pueden llevar este objeto
const HELD_BY_LIMIT = 15;
const heldByPokemon = await getPokemonListByUrls(
    (itemData.held_by_pokemon || []).map((h: any) => h.pokemon.url),
    HELD_BY_LIMIT
);

const t = uiTranslations[lang as string] || uiTranslations.es;

const breadcrumbItems = [
    { label: t.breadcrumb_home, href: pagePath(lang as string) },
    { label: t.items, href: pagePath(lang as string, 'objetos') },
    { label: localizedName },
];
---

<Layout
    title={pageTitle}
    description={description.text}
    robots={robots}
    lang={lang}
>
    <div class="max-w-5xl mx-auto">
        <Breadcrumbs items={breadcrumbItems} />
        <a href={pagePath(lang as string, 'objetos')} class="inline-flex items-center gap-2 text-slate-500 dark:text-slate-400 hover:text-emerald-500 dark:hover:text-emerald-400 font-medium transition-colors mb-8 group">
            <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            {t.back_to_items}
        </a>

        <div class="bg-white dark:bg-slate-800 rounded-[3rem] p-10 md:p-16 border border-slate-100 dark:border-slate-700 shadow-2xl shadow-slate-200/50 dark:shadow-black/40 mb-16 transition-colors overflow-hidden relative">
            <div class="absolute -top-24 -right-24 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl"></div>
            
            <div class="relative z-10">
                <div class="flex flex-col md:flex-row items-center gap-12 mb-12">
                    <div class="w-48 h-48 bg-slate-50 dark:bg-slate-900/50 rounded-[2.5rem] flex items-center justify-center p-8 border border-slate-100 dark:border-slate-800 shadow-inner">
                        {itemData.sprites?.default && (
                            <img 
                                src={itemData.sprites.default} 
                                alt={localizedName} 
                                class="w-32 h-32 pixelated transform hover:scale-110 transition-transform duration-500"
                            />
                        )}
                    </div>
                    
                    <div class="text-center md:text-left flex-grow">
                        <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mb-6">
                            <span class="px-4 py-1.5 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 text-xs font-black uppercase tracking-widest rounded-full border border-emerald-200 dark:border-emerald-800/50">
                                {categoryName}
                            </span>
                            {itemData.cost > 0 && (
                                <span class="px-4 py-1.5 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 text-xs font-black uppercase tracking-widest rounded-full border border-amber-200 dark:border-amber-800/50">
                                    {itemData.cost} ₽
                                </span>
                            )}
                        </div>
                        <h1 class="text-5xl md:text-7xl font-black text-slate-900 dark:text-white capitalize tracking-tighter mb-2">{localizedName}</h1>
                        <div class="mb-4"><ReportDataIssue entityType="item" entitySlug={itemData.name} lang={lang as string} /></div>

                        {teraType && teraTypeLabel && (
                            <a href={pagePath(lang as string, 'tipo', teraType)} class="inline-flex items-center gap-3 px-6 py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-2xl font-bold hover:scale-105 transition-transform">
                                {lang === 'es' ? 'Tipo Tera:' : 'Tera type:'} {teraTypeLabel}
                            </a>
                        )}

                        {moveDetail && (
                            <a href={moveDetail.url} class="inline-flex items-center gap-3 px-6 py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-2xl font-bold hover:scale-105 transition-transform">
                                <svg class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14H11V21L20 10H13Z"/></svg>
                                {lang === 'es' ? 'Enseña:' : 'Teaches:'} {moveDetail.name}{moveDetail.versionLabel && <span class="opacity-70 font-medium"> ({moveDetail.versionLabel})</span>}
                            </a>
                        )}
                    </div>
                </div>

                {description.source === 'facts' && (
                    <p class="text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-medium mb-8" data-item-summary>{description.text}</p>
                )}

                {showItemTexts && effect && (
                <div class="bg-emerald-50/50 dark:bg-emerald-950/10 rounded-[2rem] p-8 md:p-10 border border-emerald-100/50 dark:border-emerald-900/20 mb-8">
                    <h3 class="text-xs font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest mb-3">{t.item_effect_label}</h3>
                    <p class="text-xl md:text-2xl text-slate-700 dark:text-slate-300 leading-relaxed font-medium">
                        {effect.text}
                    </p>
                    {effect?.fallbackUsed && (
                        <p class="text-xs text-slate-400 dark:text-slate-500 italic mt-3">{t.item_effect_en_fallback}</p>
                    )}
                    <p class="text-[10px] font-bold text-slate-300 dark:text-slate-600 uppercase tracking-widest mt-4">{t.source_pokeapi}</p>
                </div>
                )}

                {showItemTexts && flavor && (
                    <div class="bg-slate-50 dark:bg-slate-900/40 rounded-[2rem] p-8 md:p-10 border border-slate-100 dark:border-slate-800 mb-12">
                        <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">{t.item_flavor_label}</h3>
                        <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed italic">
                            "{flavor.text}"
                        </p>
                    </div>
                )}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {itemData.attributes && itemData.attributes.length > 0 && (
                        <div>
                            <h3 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-4">{lang === 'es' ? 'Propiedades' : 'Properties'}</h3>
                            <div class="flex flex-wrap gap-2">
                                {itemData.attributes.map((attr: any) => (
                                    <span class="px-4 py-2 bg-slate-100 dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-sm font-bold rounded-xl border border-slate-200 dark:border-slate-800">
                                        {i18nItems[attr.name] || formatName(attr.name)}
                                    </span>
                                ))}
                            </div>
                        </div>
                    )}
                    
                    {itemData.fling_power && (
                        <div>
                            <h3 class="text-sm font-black text-slate-400 uppercase tracking-widest mb-4">
                                {lang === 'es' ? 'Potencia al Lanzar' : 'Fling Power'}
                            </h3>
                            <div class="flex items-center gap-4">
                                <div class="px-4 py-2 bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400 text-lg font-black rounded-xl border border-amber-100 dark:border-amber-900/30">
                                    {itemData.fling_power} <span class="text-xs uppercase ml-1">{t.power}</span>
                                </div>
                                <p class="text-xs text-slate-400 dark:text-slate-500 max-w-[150px] leading-tight">
                                    {lang === 'es' 
                                        ? 'Potencia del movimiento "Lanzamiento" con este objeto.' 
                                        : 'Power of the move "Fling" when using this item.'}
                                </p>
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </div>

        {heldByPokemon.length > 0 && (
            <div class="mt-20">
                <h2 class="text-3xl font-black text-slate-900 dark:text-white mb-10 px-4 flex items-center gap-4">
                    <span class="w-2 h-8 bg-emerald-500/50 rounded-full"></span>
                    {lang === 'es' ? 'Pokémon que pueden llevarlo' : 'Pokémon that can hold it'}
                    <span class="text-sm font-bold text-slate-400 dark:text-slate-600 bg-slate-100 dark:bg-slate-800/50 px-4 py-1.5 rounded-full border border-slate-200/50 dark:border-slate-700">{itemData.held_by_pokemon.length}</span>
                    {itemData.held_by_pokemon.length > heldByPokemon.length && (
                        <span class="text-xs font-bold text-slate-400 dark:text-slate-600">{lang === 'es' ? `Mostrando ${heldByPokemon.length}` : `Showing ${heldByPokemon.length}`}</span>
                    )}
                </h2>

                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
                    {heldByPokemon.map((pokemon) => (
                        <PokemonCard pokemon={pokemon} lang={lang as string} />
                    ))}
                </div>
            </div>
        )}
    </div>
</Layout>

<style>
    .pixelated { image-rendering: pixelated; }
</style>
