---
import Layout from '../../../layouts/Layout.astro';
import { getAllMoves } from '../../../services/pokeapi';
import { typeTranslations, typeColors, formatName, uiTranslations } from '../../../utils/pokemon';
import { pagePath } from '../../../utils/seo';

const { lang = 'es' } = Astro.params;
const moves = await getAllMoves();
const t = uiTranslations[lang as string] || uiTranslations.es;
---

<Layout title={t.moves_title_seo} description={t.moves_desc_seo} lang={lang}>
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
            <h1 class="text-5xl font-black text-slate-900 dark:text-white mb-4 tracking-tight">
                {t.moves}
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-lg">
                {t.moves_desc_seo}
            </p>
        </div>

        <!-- Filtros Modernos -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 mb-12">
            <div class="md:col-span-8 relative">
                <input 
                    type="text" 
                    id="move-search" 
                    placeholder={t.search_move} 
                    class="w-full pl-14 pr-6 py-5 rounded-[2rem] bg-white dark:bg-slate-800 border-2 border-slate-100 dark:border-slate-700 text-slate-900 dark:text-white text-lg shadow-2xl shadow-slate-200/50 dark:shadow-black/40 focus:border-emerald-500 outline-none transition-all"
                    autocomplete="off"
                />
                <svg class="w-6 h-6 absolute left-5 top-1/2 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <!-- Contenedor de Sugerencias -->
                <div id="search-suggestions" class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-slate-100 dark:border-slate-700 z-50 hidden overflow-hidden max-h-[400px] overflow-y-auto">
                </div>
            </div>
            <div class="md:col-span-4">
                <select id="type-filter" class="w-full px-8 py-5 rounded-[2rem] bg-white dark:bg-slate-800 border-2 border-slate-100 dark:border-slate-700 text-slate-600 dark:text-slate-400 shadow-xl shadow-slate-200/50 dark:shadow-black/20 outline-none cursor-pointer focus:border-emerald-400 appearance-none">
                    <option value="all">{t.all_types}</option>
                    {Object.keys(typeTranslations[lang as string]).map(type => (
                        <option value={type}>{typeTranslations[lang as string][type]}</option>
                    ))}
                </select>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-[2.5rem] border border-slate-100 dark:border-slate-700 shadow-2xl shadow-slate-200/50 dark:shadow-black/50 overflow-hidden transition-colors">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50/50 dark:bg-slate-900/50 text-slate-400 dark:text-slate-500 text-[10px] font-black uppercase tracking-[0.2em] border-b border-slate-100 dark:border-slate-700">
                            <th class="px-10 py-6">{lang === 'es' ? 'Ataque' : 'Move'}</th>
                            <th class="px-10 py-6 text-center">{lang === 'es' ? 'Tipo' : 'Type'}</th>
                            <th class="px-10 py-6 text-center">{lang === 'es' ? 'Categoría' : 'Cat.'}</th>
                            <th class="px-10 py-6 text-center">PRIO</th>
                            <th class="px-10 py-6 text-center">POT</th>
                            <th class="px-10 py-6 text-center">PRE</th>
                            <th class="px-10 py-6 text-center">PP</th>
                        </tr>
                    </thead>
                    <tbody id="move-table-body" class="divide-y divide-slate-50 dark:divide-slate-700/50">
                        {moves.map((move) => (
                            <tr class="move-row" data-name={move.name}>
                                <td class="mi-name"><a href={pagePath(lang as string, 'movimientos', move.name)}>{formatName(move.name)}</a></td>
                                <td class="mi-type"></td>
                                <td class="mi-cat">-</td>
                                <td class="mi-prio">-</td>
                                <td class="mi-pow">-</td>
                                <td class="mi-acc">-</td>
                                <td class="mi-pp">-</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!--
      Row styling lives in one stylesheet instead of ~7 utility-class lists and
      7 per-cell URL attributes repeated on each of the 937 rows.
    -->
    <style is:global>
        @reference "../../../styles/global.css";
        .move-row { @apply hover:bg-emerald-50/30 dark:hover:bg-emerald-950/10 transition-colors cursor-pointer; }
        .move-row td { @apply px-10 py-5 text-center; }
        .move-row td.mi-name { @apply text-left; }
        .move-row .mi-name a { @apply font-bold text-slate-900 dark:text-white capitalize no-underline transition-colors; }
        .move-row:hover .mi-name a { @apply text-emerald-600 dark:text-emerald-400; }
        .move-row .mi-prio { @apply font-mono text-sm font-bold text-slate-400; }
        /* Priority colour by data attribute: unlayered rules here would beat utility classes toggled from JS. */
        .move-row .mi-prio[data-p="up"] { @apply text-emerald-500; }
        .move-row .mi-prio[data-p="down"] { @apply text-rose-500; }
        .move-row .mi-pow, .move-row .mi-acc, .move-row .mi-pp { @apply font-mono text-sm font-bold text-slate-600 dark:text-slate-400; }
        /* Type badge placeholder until the row's move data arrives. */
        .move-row:not([data-type]) .mi-type::before { @apply inline-block h-5 w-16 bg-slate-100 dark:bg-slate-900 animate-pulse rounded-full align-middle; content: ""; }
        .move-row .mi-type span { @apply px-3 py-1 rounded-lg text-[10px] font-black uppercase text-white shadow-sm; }
        .move-row .mi-cat span { @apply px-2 py-0.5 rounded text-[9px] font-black uppercase text-white shadow-sm; }
    </style>

    <div id="movimientos-data" data-lang={lang} data-colors={JSON.stringify(typeColors)} data-translations={JSON.stringify(typeTranslations)} class="hidden"></div>

    <script>
        import { trackEvent } from '../../../utils/analytics';
        import { fetchPokeApiJson } from '../../../utils/pokeapiClient';

        interface MoveInfo {
            name: string;
            type: string;
            category: string;
            power: number | string;
            accuracy: string;
            pp: number;
            priority: number;
        }

        // Subset of the PokeAPI /move/{id} response this page reads.
        interface PokeApiMoveResponse {
            name: string;
            names?: { name: string; language: { name: string } }[];
            type: { name: string };
            damage_class?: { name: string };
            power: number | null;
            accuracy: number | null;
            pp: number;
            priority: number;
        }

        interface MoveRowEntry {
            name: string;
            el: HTMLElement;
            url: string;
        }

        type TypeColors = Record<string, string>;
        type TypeTranslations = Record<string, Record<string, string>>;
        type CatTranslations = Record<string, string>;

        // Assigned synchronously by init() on astro:page-load, before any
        // listener registered inside init() can fire — every other function
        // here is only reachable through one of those listeners.
        let searchInput!: HTMLInputElement;
        let suggestionsContainer!: HTMLElement;
        let typeFilter!: HTMLSelectElement;
        let rows!: NodeListOf<HTMLElement>;
        let itemsData!: MoveRowEntry[];
        const cache = new Map<string, MoveInfo>();

        // A row carries only the move's slug; its PokeAPI URL is derived.
        const MOVE_API = 'https://pokeapi.co/api/v2/move/';
        const moveUrl = (slug: string) => `${MOVE_API}${slug}/`;

        const catColors: CatTranslations = {
            physical: 'bg-orange-500',
            special: 'bg-indigo-500',
            status: 'bg-slate-400'
        };

        function escHtml(str: string) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        async function fetchMoveInfo(url: string, lang: string): Promise<MoveInfo | null> {
            const cached = cache.get(url);
            if (cached) return cached;
            try {
                const data = await fetchPokeApiJson<PokeApiMoveResponse>(url);
                const name = data.names?.find(n => n.language.name === lang)?.name || data.name;
                const type = data.type.name;
                const category = data.damage_class?.name || 'status';
                const power = data.power || '—';
                const accuracy = data.accuracy ? `${data.accuracy}%` : '—';
                const pp = data.pp;
                const priority = data.priority;

                const result: MoveInfo = { name, type, category, power, accuracy, pp, priority };
                cache.set(url, result);
                return result;
            } catch (e) {
                return null;
            }
        }

        async function updateSuggestions(query: string, lang: string, typeColors: TypeColors, typeTranslations: TypeTranslations, catTranslations: CatTranslations) {
            if (!query || query.length < 2) {
                suggestionsContainer.classList.add('hidden');
                return;
            }
            const queryLower = query.toLowerCase();
            const matches = itemsData.filter(item => {
                const translated = (item.el.dataset.translatedName || '').toLowerCase();
                return item.name.includes(queryLower) || translated.includes(queryLower);
            }).slice(0, 6);

            if (matches.length === 0) {
                suggestionsContainer.classList.add('hidden');
                return;
            }

            suggestionsContainer.innerHTML = '';
            suggestionsContainer.classList.remove('hidden');

            for (const item of matches) {
                const info = await fetchMoveInfo(item.url, lang);
                if (!info) continue;
                const div = document.createElement('div');
                div.className = 'flex items-center gap-4 p-4 hover:bg-slate-50 dark:hover:bg-slate-700/50 cursor-pointer border-b border-slate-50 dark:border-slate-700/50 last:border-0 transition-colors group';
                div.innerHTML = `
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-white shadow-lg shadow-black/10 transition-transform group-hover:scale-110" style="background-color: ${escHtml(typeColors[info.type] || '#777')}" aria-hidden="true">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14H11V21L20 10H13Z"/></svg>
                    </div>
                    <div>
                        <div class="font-bold text-slate-800 dark:text-white capitalize">${escHtml(info.name)}</div>
                        <div class="flex items-center gap-2 mt-0.5">
                            <span class="text-[9px] font-black uppercase text-slate-400 dark:text-slate-500 tracking-widest">${escHtml(typeTranslations[lang]?.[info.type] || info.type)}</span>
                            <span class="w-1 h-1 bg-slate-200 dark:bg-slate-700 rounded-full"></span>
                            <span class="text-[9px] font-black uppercase text-slate-400 dark:text-slate-500 tracking-widest">${escHtml(catTranslations[info.category] || info.category)}</span>
                        </div>
                    </div>
                `;
                div.onclick = () => {
                    searchInput.value = info.name;
                    suggestionsContainer.classList.add('hidden');
                    filterTable();
                };
                suggestionsContainer.appendChild(div);
            }
        }

        async function loadRow(row: HTMLElement, lang: string, typeColors: TypeColors, typeTranslations: TypeTranslations, catTranslations: CatTranslations) {
            if (!row.dataset.name) return;
            const info = await fetchMoveInfo(moveUrl(row.dataset.name), lang);
            if (info) {
                const nameEl = row.querySelector('.mi-name a');
                if (nameEl) nameEl.textContent = info.name;
                const typeEl = row.querySelector('.mi-type');
                if (typeEl) typeEl.innerHTML = `<span style="background-color: ${typeColors[info.type]}">${typeTranslations[lang]?.[info.type]}</span>`;
                const catEl = row.querySelector('.mi-cat');
                if (catEl) catEl.innerHTML = `<span class="${catColors[info.category]}">${catTranslations[info.category]}</span>`;

                const prioEl = row.querySelector<HTMLElement>('.mi-prio');
                if (prioEl) {
                    prioEl.textContent = info.priority > 0 ? `+${info.priority}` : info.priority < 0 ? String(info.priority) : '0';
                    if (info.priority !== 0) prioEl.dataset.p = info.priority > 0 ? 'up' : 'down';
                }

                const powEl = row.querySelector('.mi-pow');
                if (powEl) powEl.textContent = String(info.power);
                const accEl = row.querySelector('.mi-acc');
                if (accEl) accEl.textContent = info.accuracy;
                const ppEl = row.querySelector('.mi-pp');
                if (ppEl) ppEl.textContent = String(info.pp);

                row.dataset.translatedName = info.name.toLowerCase();
                row.dataset.type = info.type;
            }
        }

        function filterTable() {
            const query = searchInput.value.toLowerCase().trim();
            const type = typeFilter.value;

            rows.forEach(row => {
                const englishName = (row.dataset.name ?? '').toLowerCase();
                const translatedName = row.dataset.translatedName || '';
                const moveType = row.dataset.type || '';

                const matchesSearch = englishName.includes(query) || translatedName.includes(query);
                const matchesType = type === 'all' || moveType === type;

                row.style.display = (matchesSearch && matchesType) ? 'table-row' : 'none';
            });
        }

        function init() {
            const dataEl = document.getElementById('movimientos-data');
            if (!dataEl) return;
            const lang = dataEl.dataset.lang || 'es';
            const typeColors: TypeColors = JSON.parse(dataEl.dataset.colors || '{}');
            const typeTranslations: TypeTranslations = JSON.parse(dataEl.dataset.translations || '{}');

            const catTranslations: CatTranslations = {
                physical: lang === 'es' ? 'Físico' : 'Physical',
                special: lang === 'es' ? 'Especial' : 'Special',
                status: lang === 'es' ? 'Estado' : 'Status'
            };

            const searchInputEl = document.querySelector<HTMLInputElement>('#move-search');
            const suggestionsContainerEl = document.getElementById('search-suggestions');
            const typeFilterEl = document.querySelector<HTMLSelectElement>('#type-filter');
            if (!searchInputEl || !suggestionsContainerEl || !typeFilterEl) return;
            searchInput = searchInputEl;
            suggestionsContainer = suggestionsContainerEl;
            typeFilter = typeFilterEl;
            rows = document.querySelectorAll<HTMLElement>('.move-row');

            itemsData = Array.from(rows).map(row => ({
                name: row.dataset.name ?? '',
                el: row,
                url: moveUrl(row.dataset.name ?? '')
            }));

            searchInput.addEventListener('input', () => {
                filterTable();
                updateSuggestions(searchInput.value, lang, typeColors, typeTranslations, catTranslations);
            });

            typeFilter.addEventListener('change', () => {
                filterTable();
                trackEvent('filter_moves', { language: lang, target: typeFilter.value });
            });

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting && entry.target instanceof HTMLElement) {
                        const row = entry.target;
                        loadRow(row, lang, typeColors, typeTranslations, catTranslations);
                        observer.unobserve(row);
                    }
                });
            }, { rootMargin: '100px' });

            rows.forEach(row => observer.observe(row));

            // Whole-row click is a convenience on top of the real <a> in the
            // name cell (which crawlers and keyboard users follow); clicks on
            // the anchor itself keep their native behavior.
            document.getElementById('move-table-body')?.addEventListener('click', (e) => {
                if (!(e.target instanceof Element) || e.target.closest('a')) return;
                const href = e.target.closest('.move-row')?.querySelector('a')?.getAttribute('href');
                if (href) window.location.href = href;
            });

            document.addEventListener('click', (e) => {
                if (!(e.target instanceof Node)) return;
                if (searchInput && suggestionsContainer && !searchInput.contains(e.target) && !suggestionsContainer.contains(e.target)) {
                    suggestionsContainer.classList.add('hidden');
                }
            });
        }

        document.addEventListener('astro:page-load', init);
    </script>
</Layout>
