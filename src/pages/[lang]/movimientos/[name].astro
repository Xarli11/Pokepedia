---
import Layout from '../../../layouts/Layout.astro';
import PokemonRelationList from '../../../components/PokemonRelationList.astro';
import ReportDataIssue from '../../../components/ReportDataIssue.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getLocalizedName, getMoveDetailByName, idFromResourceUrl, GENERATION_ROMAN } from '../../../services/pokeapi';
import { uiTranslations, formatName, typeTranslations, typeColors } from '../../../utils/pokemon';
import { pagePath } from '../../../utils/seo';
import { buildMoveTitle, resolveMoveDescription, type MoveFacts } from '../../../utils/moveMeta';
import { buildMoveMechanics, targetLabel, ailmentLabel, movePastValues } from '../../../utils/moveFacts';
import { getMachinesForMove } from '../../../services/machines';
import { getMoveFlags } from '../../../services/moveFlagsData';
import { moveFlagLabel } from '../../../utils/moveFlags';
import { getItemCatalog, getCatalog } from '../../../services/catalogs';
import { versionGroupLabel, sortVersionGroups } from '../../../services/versionGroups';
import { getMoveLearnsetRelations } from '../../../services/moveLearnsets';
import { availableGameContextsForMove, defaultGameContextForMove, relationsForContext, methodsPresent } from '../../../utils/moveLearnsetFacts';
import { gameContextLabel } from '../../../services/gameContext';
import { learnMethodIndex, learnMethodLabel } from '../../../utils/moveLearnMethods';
import { versionGroupRank } from '../../../services/versionGroups';
import { jsonForScript } from '../../../utils/movesPayload';

const { lang, name } = Astro.params;

// Only this primary lookup can 404 the page (EntityNotFoundError). An
// UpstreamError or a missing related resource is answered 503 by
// src/middleware.ts; any other error surfaces as a real 500.
const moveData = await getMoveDetailByName((name as string).toLowerCase());

// PokeAPI resolves numeric ids and any casing (/57/, /Surf/ -> surf), which
// made each of those a second 200 page. Only the canonical slug renders.
if (name !== moveData.name) {
    return Astro.redirect(pagePath(lang as string, 'movimientos', moveData.name), 301);
}

const localizedName = getLocalizedName(moveData.names, lang as string) || formatName(moveData.name);
const moveType = moveData.type.name;
// Types without a Pokepedia page (PokeAPI's "shadow", used by 18 XD moves)
// stay plain text: /tipo/shadow/ would 404.
const typePageExists = moveType in typeColors;
const typeLabel = typeTranslations[lang as string]?.[moveType] || formatName(moveType);

const facts: MoveFacts = {
    name: localizedName,
    typeLabel,
    category: moveData.damage_class.name,
    power: moveData.power,
    accuracy: moveData.accuracy,
    pp: moveData.pp,
    priority: moveData.priority,
};
// Real localized flavor text when it exists; otherwise a factual sentence in
// the page language (never English text on a Spanish page).
const description = resolveMoveDescription(lang as string, facts, moveData.flavor_text_entries);
const pageTitle = buildMoveTitle(lang as string, facts);

const t = uiTranslations[lang as string] || uiTranslations.es;

// Mechanics, generation link, historical values and MT/MO/TR availability —
// all from fields already in `moveData` or a zero-request generated dataset
// (services/machines.ts). See docs/architecture/move-ability-entities.md.
const mechanics = buildMoveMechanics(moveData.target, moveData.meta, moveData.stat_changes);
const pastValues = movePastValues(moveData.past_values);

const moveGenNumRaw = moveData.generation?.url ? idFromResourceUrl(moveData.generation.url) : null;
const moveGenKey = moveGenNumRaw ? `gen${moveGenNumRaw}` : null;
const moveGenRoman = moveGenKey ? GENERATION_ROMAN[moveGenKey] : null;

const machinesRaw = await getMachinesForMove(moveData.name);
// Fase 2F: curated factual Showdown flags (contact, sound, punch...) —
// PokeAPI has no such field. Zero-request generated dataset, same pattern
// as machines above. See src/utils/moveFlags.ts for the exact set and why
// it excludes battle-mechanic-interaction flags.
const moveFlags = await getMoveFlags(moveData.name);
const itemCatalog = machinesRaw.length > 0 ? await getItemCatalog(lang as string) : null;
const machineVersionGroups = sortVersionGroups(machinesRaw.map((m) => m.versionGroup)).reverse();
const machinesByVersionGroup = new Map(machinesRaw.map((m) => [m.versionGroup, m.item]));
const machines = machineVersionGroups.map((vg) => {
    const itemSlug = machinesByVersionGroup.get(vg)!;
    return {
        versionGroupLabel: versionGroupLabel(vg, lang as string),
        itemLabel: itemCatalog?.get(itemSlug)?.name ?? itemSlug.toUpperCase(),
    };
});
const MACHINES_VISIBLE = 8;

// Pokémon ↔ Move relations (who learns this move, how, in which game),
// inverted offline from PokeAPI's pokemon/{id}.moves — zero extra requests
// here. See docs/architecture/move-learnset-relations.md.
const relations = await getMoveLearnsetRelations(moveData.name);
const availableContexts = availableGameContextsForMove(relations);
const defaultContext = defaultGameContextForMove(relations);
const defaultContextAvailability = availableContexts.find((a) => a.context.id === defaultContext.contextId);
// A Game Context's full revision span (base game + its DLC), not just the
// latest revision — a Pokémon that only learns the move via an older
// revision must not disappear just because a newer one is also present.
const defaultRevisions = defaultContextAvailability?.availableRevisions ?? (defaultContext.revision ? [defaultContext.revision] : []);
const defaultEntries = relationsForContext(relations, defaultRevisions);
const availableMethods = methodsPresent(defaultEntries);
// Honest disclosure (§26): the visible count is Pokémon in the current
// game context, never conflated with the all-time total across every game.
const distinctHistoricalCount = new Set(relations.map((r) => r.pokemonId)).size;

// Pokémon id -> {slug, name}: the generated learnset dataset only has ids
// (compact by design); the already-generated Pokémon catalog resolves them
// to real links/names with no extra request, built once per relevant id.
const pokemonCatalogEntries = relations.length > 0 ? [...(await getCatalog('pokemon', lang as string)).values()] : [];
const pokemonById = new Map(pokemonCatalogEntries.map((e) => [e.id, e]));

// One machine label per context (not per Pokémon — a TM/HM/TR number is a
// property of the game, not of who learns it), resolved from the same
// machines dataset as the MT/MO/TR section above, at that context's
// representative (most recent available) revision.
const machineLabelByContext = new Map(
    availableContexts.map((a) => {
        const itemSlug = machinesByVersionGroup.get(a.latestRevision);
        const label = itemSlug ? (itemCatalog?.get(itemSlug)?.name ?? itemSlug.toUpperCase()) : t.machines_section;
        return [a.context.id, label];
    })
);

function methodDetail(method: string, level: number, contextId: string): string {
    if (method === 'level-up' && level > 0) return lang === 'en' ? `Lv. ${level}` : `Nivel ${level}`;
    if (method === 'machine') return machineLabelByContext.get(contextId) ?? t.machines_section;
    return learnMethodLabel(method, lang as string);
}

const defaultRelationEntries = defaultEntries
    .map((entry) => {
        const cat = pokemonById.get(entry.pokemonId);
        if (!cat) return null;
        return {
            pokemon: { id: entry.pokemonId, slug: cat.slug, name: cat.name },
            detail: entry.methods.map((m) => methodDetail(m.method, m.level, defaultContext.contextId)).join(' · '),
            methods: entry.methods.map((m) => m.method),
        };
    })
    .filter((e): e is NonNullable<typeof e> => e !== null);

// Compact client payload: every relation this move has (all contexts), so
// switching context/method needs no request — the same principle
// MovesTable already established for version groups. [pokemonId,
// methodIndex, versionGroupIndex, level] reuses the exact shared index
// tables the generator itself encodes against (LEARN_METHOD_ORDER /
// VERSION_GROUP_ORDER), so client and server can't drift apart.
const compactRelations: [number, number, number, number][] = relations.map((r) => [
    r.pokemonId,
    learnMethodIndex(r.method),
    versionGroupRank(r.versionGroup),
    r.level,
]);
const pokemonNamesPayload: Record<string, [string, string]> = {};
for (const r of relations) {
    const cat = pokemonById.get(r.pokemonId);
    if (cat && !pokemonNamesPayload[r.pokemonId]) pokemonNamesPayload[r.pokemonId] = [cat.slug, cat.name];
}
const contextsPayload = availableContexts.map((a) => ({
    id: a.context.id,
    label: gameContextLabel(a.context.id, lang as string),
    revisions: a.availableRevisions,
    machineLabel: machineLabelByContext.get(a.context.id) ?? t.machines_section,
}));

const categoryColors: Record<string, string> = {
    physical: 'bg-orange-500',
    special: 'bg-indigo-500',
    status: 'bg-slate-400'
};

const categoryLabels: Record<string, string> = {
    physical: `💪 ${t.physical}`,
    special: `🔮 ${t.special}`,
    status: `✨ ${t.status}`
};

const breadcrumbItems = [
    { label: t.breadcrumb_home, href: pagePath(lang as string) },
    { label: t.moves, href: pagePath(lang as string, 'movimientos') },
    { label: localizedName },
];
---

<Layout title={pageTitle} description={description.text} lang={lang}>
    <div class="max-w-5xl mx-auto">
        <Breadcrumbs items={breadcrumbItems} />
        <a href={pagePath(lang as string, 'movimientos')} class="inline-flex items-center gap-2 text-slate-500 dark:text-slate-400 hover:text-emerald-500 dark:hover:text-emerald-400 font-medium transition-colors mb-8 group">
            <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            {t.back_to_moves}
        </a>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-16">
            <!-- Cabecera y Descripción -->
            <div class="md:col-span-8">
                <div class="bg-white dark:bg-slate-800 rounded-[3.5rem] p-10 md:p-14 border border-slate-100 dark:border-slate-700 shadow-2xl shadow-slate-200/50 dark:shadow-black/50 h-full transition-colors duration-300">
                    <div class="flex flex-wrap items-center gap-3 mb-8">
                        {typePageExists ? (
                            <a href={pagePath(lang as string, 'tipo', moveType)} class="px-5 py-2 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] text-white shadow-lg no-underline hover:brightness-110 transition" style={`background-color: ${typeColors[moveType]}`}>
                                {typeLabel}
                            </a>
                        ) : (
                            <span class="px-5 py-2 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] text-white shadow-lg bg-slate-500">
                                {typeLabel}
                            </span>
                        )}
                        <span class={`${categoryColors[moveData.damage_class.name]} text-white px-5 py-2 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] shadow-lg`}>
                            {categoryLabels[moveData.damage_class.name]}
                        </span>
                        {moveGenRoman && moveGenKey && (
                            <a href={pagePath(lang as string, 'generacion', String(moveGenNumRaw))} class="px-5 py-2 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] bg-slate-100 dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:bg-emerald-500 hover:text-white transition-all no-underline">
                                {t.generation_label} {moveGenRoman}
                            </a>
                        )}
                    </div>
                    <h1 class="text-6xl font-black text-slate-900 dark:text-white mb-2 capitalize leading-tight tracking-tighter">{localizedName}</h1>
                    <div class="mb-6"><ReportDataIssue entityType="move" entitySlug={moveData.name} lang={lang as string} /></div>
                    <div class="bg-emerald-50/50 dark:bg-emerald-950/10 rounded-3xl p-8 border border-emerald-100/50 dark:border-emerald-900/20">
                        <p class="text-xl text-slate-700 dark:text-slate-300 leading-relaxed italic font-medium">
                            {description.source === 'flavor' ? `"${description.text}"` : description.text}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Panel de Datos Técnicos -->
            <div class="md:col-span-4">
                <div class="bg-emerald-600 dark:bg-emerald-500 rounded-[3.5rem] p-10 shadow-2xl shadow-emerald-200 dark:shadow-black/50 h-full flex flex-col justify-between text-white transition-all duration-300">
                    <div class="space-y-8">
                        <div class="flex justify-between items-end border-b border-emerald-500/30 pb-4">
                            <div>
                                <p class="text-emerald-100/70 text-[10px] font-black uppercase tracking-widest mb-1">{t.power}</p>
                                <p class="text-4xl font-black">{moveData.power || '—'}</p>
                            </div>
                            <div class="p-3 bg-white/10 rounded-2xl backdrop-blur-sm" aria-hidden="true">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            </div>
                        </div>
                        <div class="flex justify-between items-end border-b border-emerald-500/30 pb-4">
                            <div>
                                <p class="text-emerald-100/70 text-[10px] font-black uppercase tracking-widest mb-1">{t.accuracy}</p>
                                <p class="text-4xl font-black">{moveData.accuracy ? `${moveData.accuracy}%` : '—'}</p>
                            </div>
                            <div class="p-3 bg-white/10 rounded-2xl backdrop-blur-sm" aria-hidden="true">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                        </div>
                        <div class="flex justify-between items-end border-b border-emerald-500/30 pb-4">
                            <div>
                                <p class="text-emerald-100/70 text-[10px] font-black uppercase tracking-widest mb-1">{t.priority}</p>
                                <p class={`text-4xl font-black ${moveData.priority > 0 ? 'text-white' : moveData.priority < 0 ? 'text-rose-200' : 'text-emerald-100'}`}>
                                    {moveData.priority > 0 ? `+${moveData.priority}` : moveData.priority}
                                </p>
                            </div>
                            <div class="p-3 bg-white/10 rounded-2xl backdrop-blur-sm">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                        </div>
                        <div class="flex justify-between items-end border-b border-emerald-500/30 pb-4">
                            <div>
                                <p class="text-emerald-100/70 text-[10px] font-black uppercase tracking-widest mb-1">{t.pp}</p>
                                <p class="text-4xl font-black">{moveData.pp}</p>
                            </div>
                            <div class="p-3 bg-white/10 rounded-2xl backdrop-blur-sm">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {moveFlags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-10">
                {moveFlags.map((f) => (
                    <span class="px-3 py-1.5 bg-slate-50 dark:bg-slate-800/50 rounded-xl text-[10px] font-black uppercase tracking-wider text-slate-500 dark:text-slate-400 border border-slate-100 dark:border-slate-700">{moveFlagLabel(f, lang as string)}</span>
                ))}
            </div>
        )}

        {(mechanics.ailment || mechanics.drain || mechanics.recoil || mechanics.healing || mechanics.critRate || mechanics.flinchChance || mechanics.minHits || mechanics.minTurns || mechanics.statChanges.length > 0) && (
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm mb-16">
                <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.mechanics}</h2>
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4 text-sm">
                    <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_target}</dt><dd class="text-slate-900 dark:text-white font-black text-right">{targetLabel(mechanics.target, lang as string)}</dd></div>
                    {mechanics.ailment && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_ailment}</dt><dd class="text-slate-900 dark:text-white font-black text-right">{ailmentLabel(mechanics.ailment, lang as string)}{mechanics.ailmentChance ? ` (${mechanics.ailmentChance}%)` : ''}</dd></div>
                    )}
                    {mechanics.drain != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_drain}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.drain}%</dd></div>
                    )}
                    {mechanics.recoil != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_recoil}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.recoil}%</dd></div>
                    )}
                    {mechanics.healing != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_healing}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.healing}%</dd></div>
                    )}
                    {mechanics.critRate != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_crit_rate}</dt><dd class="text-slate-900 dark:text-white font-black">+{mechanics.critRate}</dd></div>
                    )}
                    {mechanics.flinchChance != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_flinch_chance}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.flinchChance}%</dd></div>
                    )}
                    {mechanics.minHits != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_hits}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.minHits === mechanics.maxHits ? mechanics.minHits : `${mechanics.minHits}–${mechanics.maxHits}`}</dd></div>
                    )}
                    {mechanics.minTurns != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_turns}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.minTurns === mechanics.maxTurns ? mechanics.minTurns : `${mechanics.minTurns}–${mechanics.maxTurns}`}</dd></div>
                    )}
                    {mechanics.statChanges.length > 0 && (
                        <div class="sm:col-span-2 flex justify-between gap-4">
                            <dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_stat_changes}</dt>
                            <dd class="text-slate-900 dark:text-white font-black text-right">
                                {mechanics.statChanges.map((s) => `${t[s.stat] || s.stat} ${s.change > 0 ? '+' : ''}${s.change}`).join(', ')}
                                {mechanics.statChance ? ` (${mechanics.statChance}%)` : ''}
                            </dd>
                        </div>
                    )}
                </dl>
            </div>
        )}

        {machines.length > 0 && (
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm mb-16">
                <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.machines_section}</h2>
                <ul class="flex flex-wrap gap-2 text-xs list-none p-0 m-0">
                    {machines.slice(0, MACHINES_VISIBLE).map((m) => (
                        <li class="px-3 py-1.5 bg-slate-50 dark:bg-slate-800/50 rounded-xl font-bold text-slate-600 dark:text-slate-300">{m.itemLabel} · {m.versionGroupLabel}</li>
                    ))}
                </ul>
                {machines.length > MACHINES_VISIBLE && (
                    <details class="mt-3">
                        <summary class="text-xs font-bold text-emerald-600 dark:text-emerald-400 cursor-pointer">{lang === 'es' ? `Ver ${machines.length - MACHINES_VISIBLE} más` : `Show ${machines.length - MACHINES_VISIBLE} more`}</summary>
                        <ul class="flex flex-wrap gap-2 text-xs list-none p-0 mt-3">
                            {machines.slice(MACHINES_VISIBLE).map((m) => (
                                <li class="px-3 py-1.5 bg-slate-50 dark:bg-slate-800/50 rounded-xl font-bold text-slate-600 dark:text-slate-300">{m.itemLabel} · {m.versionGroupLabel}</li>
                            ))}
                        </ul>
                    </details>
                )}
            </div>
        )}

        {pastValues.length > 0 && (
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm mb-16">
                <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.move_history}</h2>
                <ul class="space-y-3 text-sm list-none p-0 m-0">
                    {pastValues.map((v) => {
                        const parts: string[] = [];
                        if (v.power != null) parts.push(`${t.power} ${v.power}`);
                        if (v.accuracy != null) parts.push(`${t.accuracy} ${v.accuracy}%`);
                        if (v.pp != null) parts.push(`PP ${v.pp}`);
                        if (v.type) parts.push(`${t.pokemon_types}: ${typeTranslations[lang as string]?.[v.type] || formatName(v.type)}`);
                        return (
                            <li class="text-slate-600 dark:text-slate-400">
                                <span class="font-black text-slate-900 dark:text-white">{versionGroupLabel(v.versionGroup, lang as string)}{lang === 'es' ? ' y anteriores' : ' and earlier'}:</span> {parts.join(', ')}
                            </li>
                        );
                    })}
                </ul>
            </div>
        )}

        <div class="flex flex-wrap items-center justify-between gap-4 mb-10 px-4">
            <h2 class="text-3xl font-black text-slate-900 dark:text-white flex items-center gap-4">
                <span class="w-2 h-8 bg-emerald-500 rounded-full"></span>
                {t.pokemon_with_move}
                <span id="learnset-count" class="text-sm font-bold text-slate-400 dark:text-slate-600 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-full border border-slate-200/50 dark:border-slate-700">{defaultRelationEntries.length}</span>
                <!--
                  Always rendered, never conditionally omitted: visibility is
                  a `hidden` class the client script toggles on every context/
                  method change (see setupLearnsets' updateHistorical below).
                  An SSR-conditional element can only ever match the SSR
                  default context — it can't come back once removed from the
                  DOM, which is exactly the "Total histórico" bug this fixes.
                  Meaning, always: distinct Pokémon across every relation this
                  move has, in ANY Game Context — never scoped to the
                  currently selected method (see §2 of
                  docs/architecture/move-learnset-relations.md).
                -->
                <span id="learnset-historical" class:list={['text-xs font-bold text-slate-400 dark:text-slate-600', { hidden: distinctHistoricalCount <= defaultRelationEntries.length }]}>{t.learnset_total_historical}: {distinctHistoricalCount}</span>
            </h2>
            {availableContexts.length > 0 && (
                <div class="flex flex-wrap items-center gap-3">
                    <div class="relative">
                        <label for="learnset-context" class="sr-only">{t.game}</label>
                        <select id="learnset-context" aria-label={t.game} class="px-5 py-2 rounded-xl bg-white dark:bg-slate-900 border-2 border-slate-100 dark:border-slate-700 text-xs font-bold uppercase tracking-widest focus:outline-none focus:border-emerald-500/50 transition-all cursor-pointer appearance-none dark:text-slate-300">
                            {availableContexts.map((a) => (
                                <option value={a.context.id} selected={a.context.id === defaultContext.contextId}>{gameContextLabel(a.context.id, lang as string)}</option>
                            ))}
                        </select>
                    </div>
                    <!--
                      Always rendered (never `{availableMethods.length > 1 && ...}`):
                      the client script rebuilds these options AND toggles
                      this wrapper's `hidden` class on every context change,
                      because a different Game Context can have a different
                      set of methods (that's the whole bug this fixes — see
                      updateMethodControl below). The "all" option's markup
                      is also this control's one static source of truth for
                      its own (already localized) label; the script re-reads
                      it rather than hard-coding the text a second time.
                    -->
                    <div id="learnset-method-wrapper" class:list={['relative', { hidden: availableMethods.length <= 1 }]}>
                        <label for="learnset-method" class="sr-only">{t.learnset_method_filter}</label>
                        <select id="learnset-method" aria-label={t.learnset_method_filter} class="px-5 py-2 rounded-xl bg-white dark:bg-slate-900 border-2 border-slate-100 dark:border-slate-700 text-xs font-bold uppercase tracking-widest focus:outline-none focus:border-emerald-500/50 transition-all cursor-pointer appearance-none dark:text-slate-300">
                            <option value="all">{t.learnset_all_methods}</option>
                            {availableMethods.map((m) => (
                                <option value={m}>{learnMethodLabel(m, lang as string)}</option>
                            ))}
                        </select>
                    </div>
                </div>
            )}
        </div>

        <div id="learnset-list" class={defaultRelationEntries.length === 0 ? 'hidden' : ''}>
            <PokemonRelationList entries={defaultRelationEntries} lang={lang as string} />
        </div>
        <div id="learnset-empty" class:list={['p-16 text-center text-slate-400 dark:text-slate-600 font-bold tracking-tight', { hidden: defaultRelationEntries.length > 0 }]}>{t.learnset_no_results}</div>

        <script type="application/json" id="learnset-data" is:inline set:html={jsonForScript({
            contexts: contextsPayload,
            initialContext: defaultContext.contextId,
            pokemon: pokemonNamesPayload,
            relations: compactRelations,
        })} />
    </div>

    <script>
    import { pagePath } from '../../../utils/seo';
    import { relationsForContext, filterByMethod, methodsPresent } from '../../../utils/moveLearnsetFacts';
    import { learnMethodByIndex, learnMethodLabel } from '../../../utils/moveLearnMethods';
    import { VERSION_GROUP_ORDER } from '../../../services/versionGroups';
    import { readGameContext, writeGameContext, resolveContextForPokemon } from '../../../utils/gameContextStorage';
    import { trackEvent } from '../../../utils/analytics';

    interface LearnsetPayload {
        contexts: { id: string; label: string; revisions: string[]; machineLabel: string }[];
        initialContext: string;
        pokemon: Record<string, [string, string]>;
        relations: [number, number, number, number][];
    }

    function setupLearnsets() {
        const dataScript = document.getElementById('learnset-data');
        if (!dataScript) return;
        const payload: LearnsetPayload = JSON.parse(dataScript.textContent || '{}');
        if (!payload.contexts || payload.contexts.length === 0) return;

        const langAttr = document.documentElement.lang || 'es';
        const relations = payload.relations.map(([pokemonId, methodIdx, vgIdx, level]) => ({
            pokemonId,
            method: learnMethodByIndex(methodIdx),
            versionGroup: VERSION_GROUP_ORDER[vgIdx] ?? '',
            level,
        }));

        let storage: Storage | null = null;
        try { storage = window.localStorage; } catch { storage = null; }
        const availableIds = payload.contexts.map((c) => c.id);
        const persisted = storage ? resolveContextForPokemon(readGameContext(storage), availableIds, payload.initialContext) : payload.initialContext;
        let currentContext = availableIds.includes(persisted) ? persisted : payload.initialContext;
        let currentMethod = 'all';
        // Distinct Pokémon across every relation, any Game Context, any
        // method — a single number that never changes as the user switches
        // context/method (see docs/architecture/move-learnset-relations.md
        // §2 for why "Total histórico" always means this, never "historical
        // total for the currently filtered method").
        const historicalCount = new Set(relations.map((r) => r.pokemonId)).size;

        const contextSelect = document.getElementById('learnset-context') as HTMLSelectElement | null;
        const methodSelect = document.getElementById('learnset-method') as HTMLSelectElement | null;
        const methodWrapperEl = document.getElementById('learnset-method-wrapper');
        const listEl = document.getElementById('learnset-list');
        const emptyEl = document.getElementById('learnset-empty');
        const countEl = document.getElementById('learnset-count');
        const historicalEl = document.getElementById('learnset-historical');
        if (contextSelect) contextSelect.value = currentContext;
        // The "all" option's markup is server-rendered with the already-
        // localized label (t.learnset_all_methods) — captured once here so
        // rebuilding the other options never needs to know that string.
        const allOptionHtml = methodSelect?.querySelector('option[value="all"]')?.outerHTML ?? '<option value="all">All</option>';

        function methodDetail(method: string, level: number, machineLabel: string): string {
            if (method === 'level-up' && level > 0) return langAttr === 'en' ? `Lv. ${level}` : `Nivel ${level}`;
            if (method === 'machine') return machineLabel;
            return learnMethodLabel(method, langAttr);
        }

        // The set of methods a Game Context offers is a property of THAT
        // context, not a fixed, page-wide fact computed once from the SSR
        // default — this is what makes Outrage's "Tutor" (present in
        // Platinum, absent from Scarlet/Violet) show up only after this
        // runs for the newly selected context. Always resets the filter to
        // "all": a method selected in the previous context may not exist,
        // or mean something different, in the new one.
        function updateMethodControl(ctxEntries: ReturnType<typeof relationsForContext>) {
            const methods = methodsPresent(ctxEntries);
            if (methodSelect) {
                methodSelect.innerHTML = allOptionHtml + methods.map((m) => `<option value="${m}">${learnMethodLabel(m, langAttr)}</option>`).join('');
                methodSelect.value = 'all';
            }
            methodWrapperEl?.classList.toggle('hidden', methods.length <= 1);
            currentMethod = 'all';
        }

        function render() {
            const ctx = payload.contexts.find((c) => c.id === currentContext);
            if (!ctx || !listEl) return;
            const ctxEntries = relationsForContext(relations, ctx.revisions);
            const entries = filterByMethod(ctxEntries, currentMethod);
            if (countEl) countEl.textContent = String(entries.length);
            // Only meaningful (and only shown) with no method filter active —
            // filtering already explains why the main counter is smaller;
            // showing "Total histórico" at the same time would read as if it
            // were scoped to that method, which it never is (see the
            // historicalCount comment above).
            historicalEl?.classList.toggle('hidden', !(currentMethod === 'all' && historicalCount > ctxEntries.length));

            if (entries.length === 0) {
                listEl.classList.add('hidden');
                emptyEl?.classList.remove('hidden');
                return;
            }
            listEl.classList.remove('hidden');
            emptyEl?.classList.add('hidden');

            const SPRITE = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon';
            listEl.innerHTML = `<ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 list-none p-0 m-0">${entries.map((e) => {
                const nameSlug = payload.pokemon[String(e.pokemonId)];
                if (!nameSlug) return '';
                const [slug, name] = nameSlug;
                const detail = e.methods.map((m) => methodDetail(m.method, m.level, ctx.machineLabel)).join(' · ');
                const href = pagePath(langAttr, 'pokemon', slug);
                const displayName = name.replace(/-/g, ' ');
                return `<li><a href="${href}" class="flex items-center gap-3 p-3 bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 hover:border-emerald-500/50 hover:bg-emerald-50/30 dark:hover:bg-emerald-950/10 transition-all no-underline group">` +
                    `<img src="${SPRITE}/${e.pokemonId}.png" alt="" width="40" height="40" loading="lazy" decoding="async" class="w-10 h-10 object-contain shrink-0 group-hover:scale-110 transition-transform" onerror="this.src='/pokeball.png'; this.classList.add('opacity-20');" />` +
                    `<span class="min-w-0"><span class="block text-xs font-bold text-slate-700 dark:text-slate-200 capitalize truncate">${displayName}</span>` +
                    (detail ? `<span class="block text-[10px] font-black text-slate-400 dark:text-slate-500 uppercase tracking-wider truncate">${detail}</span>` : '') +
                    `</span></a></li>`;
            }).join('')}</ul>`;
        }

        contextSelect?.addEventListener('change', (e) => {
            currentContext = (e.target as HTMLSelectElement).value;
            const ctx = payload.contexts.find((c) => c.id === currentContext);
            updateMethodControl(ctx ? relationsForContext(relations, ctx.revisions) : []);
            if (storage) writeGameContext(storage, currentContext);
            trackEvent('move_learnset_context_change', { target: currentContext, language: langAttr, source_surface: 'move_learnset' });
            render();
        });
        methodSelect?.addEventListener('change', (e) => {
            currentMethod = (e.target as HTMLSelectElement).value;
            trackEvent('move_learnset_method_filter', { target: currentMethod, language: langAttr, source_surface: 'move_learnset' });
            render();
        });

        // Hydration found a different, available persisted context than the
        // SSR default: the method control was built for the SSR context, so
        // it must be rebuilt for the restored one BEFORE the first render —
        // otherwise a persisted Platinum would render Platinum's list under
        // Scarlet/Violet's method options (empty/wrong) for one frame, and
        // wrongly leave a method filter selected that Platinum may not have.
        if (currentContext !== payload.initialContext) {
            const ctx = payload.contexts.find((c) => c.id === currentContext);
            updateMethodControl(ctx ? relationsForContext(relations, ctx.revisions) : []);
            render();
        }
    }

    setupLearnsets();
    document.addEventListener('astro:after-swap', setupLearnsets);
    </script>
</Layout>
