---
import Layout from '../../../layouts/Layout.astro';
import PokemonRelationList from '../../../components/PokemonRelationList.astro';
import ReportDataIssue from '../../../components/ReportDataIssue.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getLocalizedName, getMoveDetailByName, getPokemonCards, idFromResourceUrl, GENERATION_ROMAN } from '../../../services/pokeapi';
import { uiTranslations, formatName, typeTranslations, typeColors } from '../../../utils/pokemon';
import { pagePath } from '../../../utils/seo';
import { buildMoveTitle, resolveMoveDescription, type MoveFacts } from '../../../utils/moveMeta';
import { buildMoveMechanics, targetLabel, ailmentLabel, movePastValues } from '../../../utils/moveFacts';
import { getMachinesForMove } from '../../../services/machines';
import { getItemCatalog } from '../../../services/catalogs';
import { versionGroupLabel, sortVersionGroups } from '../../../services/versionGroups';

const { lang, name } = Astro.params;

// Only this primary lookup can 404 the page (EntityNotFoundError). An
// UpstreamError or a missing related resource is answered 503 by
// src/middleware.ts; any other error surfaces as a real 500.
const moveData = await getMoveDetailByName((name as string).toLowerCase());

// PokeAPI resolves numeric ids and any casing (/57/, /Surf/ -> surf), which
// made each of those a second 200 page. Only the canonical slug renders.
if (name !== moveData.name) {
    return Astro.redirect(pagePath(lang as string, 'movimientos', moveData.name), 301);
}

const localizedName = getLocalizedName(moveData.names, lang as string) || formatName(moveData.name);
const moveType = moveData.type.name;
// Types without a Pokepedia page (PokeAPI's "shadow", used by 18 XD moves)
// stay plain text: /tipo/shadow/ would 404.
const typePageExists = moveType in typeColors;
const typeLabel = typeTranslations[lang as string]?.[moveType] || formatName(moveType);

const facts: MoveFacts = {
    name: localizedName,
    typeLabel,
    category: moveData.damage_class.name,
    power: moveData.power,
    accuracy: moveData.accuracy,
    pp: moveData.pp,
    priority: moveData.priority,
};
// Real localized flavor text when it exists; otherwise a factual sentence in
// the page language (never English text on a Spanish page).
const description = resolveMoveDescription(lang as string, facts, moveData.flavor_text_entries);
const pageTitle = buildMoveTitle(lang as string, facts);

// The list is capped for page weight; the counter reports the real total
// (learned_by_pokemon), not the number of cards rendered.
const POKEMON_LIST_LIMIT = 60;
const totalLearnedBy = moveData.learned_by_pokemon.length;
const pokemonList = await getPokemonCards(moveData.learned_by_pokemon, POKEMON_LIST_LIMIT);

const t = uiTranslations[lang as string] || uiTranslations.es;

// Mechanics, generation link, historical values and MT/MO/TR availability —
// all from fields already in `moveData` or a zero-request generated dataset
// (services/machines.ts). See docs/architecture/move-ability-entities.md.
const mechanics = buildMoveMechanics(moveData.target, moveData.meta, moveData.stat_changes);
const pastValues = movePastValues(moveData.past_values);

const moveGenNumRaw = moveData.generation?.url ? idFromResourceUrl(moveData.generation.url) : null;
const moveGenKey = moveGenNumRaw ? `gen${moveGenNumRaw}` : null;
const moveGenRoman = moveGenKey ? GENERATION_ROMAN[moveGenKey] : null;

const machinesRaw = await getMachinesForMove(moveData.name);
const itemCatalog = machinesRaw.length > 0 ? await getItemCatalog(lang as string) : null;
const machineVersionGroups = sortVersionGroups(machinesRaw.map((m) => m.versionGroup)).reverse();
const machinesByVersionGroup = new Map(machinesRaw.map((m) => [m.versionGroup, m.item]));
const machines = machineVersionGroups.map((vg) => {
    const itemSlug = machinesByVersionGroup.get(vg)!;
    return {
        versionGroupLabel: versionGroupLabel(vg, lang as string),
        itemLabel: itemCatalog?.get(itemSlug)?.name ?? itemSlug.toUpperCase(),
    };
});
const MACHINES_VISIBLE = 8;

const categoryColors: Record<string, string> = {
    physical: 'bg-orange-500',
    special: 'bg-indigo-500',
    status: 'bg-slate-400'
};

const categoryLabels: Record<string, string> = {
    physical: `💪 ${t.physical}`,
    special: `🔮 ${t.special}`,
    status: `✨ ${t.status}`
};

const breadcrumbItems = [
    { label: t.breadcrumb_home, href: pagePath(lang as string) },
    { label: t.moves, href: pagePath(lang as string, 'movimientos') },
    { label: localizedName },
];
---

<Layout title={pageTitle} description={description.text} lang={lang}>
    <div class="max-w-5xl mx-auto">
        <Breadcrumbs items={breadcrumbItems} />
        <a href={pagePath(lang as string, 'movimientos')} class="inline-flex items-center gap-2 text-slate-500 dark:text-slate-400 hover:text-emerald-500 dark:hover:text-emerald-400 font-medium transition-colors mb-8 group">
            <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            {t.back_to_moves}
        </a>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-16">
            <!-- Cabecera y Descripción -->
            <div class="md:col-span-8">
                <div class="bg-white dark:bg-slate-800 rounded-[3.5rem] p-10 md:p-14 border border-slate-100 dark:border-slate-700 shadow-2xl shadow-slate-200/50 dark:shadow-black/50 h-full transition-colors duration-300">
                    <div class="flex flex-wrap items-center gap-3 mb-8">
                        {typePageExists ? (
                            <a href={pagePath(lang as string, 'tipo', moveType)} class="px-5 py-2 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] text-white shadow-lg no-underline hover:brightness-110 transition" style={`background-color: ${typeColors[moveType]}`}>
                                {typeLabel}
                            </a>
                        ) : (
                            <span class="px-5 py-2 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] text-white shadow-lg bg-slate-500">
                                {typeLabel}
                            </span>
                        )}
                        <span class={`${categoryColors[moveData.damage_class.name]} text-white px-5 py-2 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] shadow-lg`}>
                            {categoryLabels[moveData.damage_class.name]}
                        </span>
                        {moveGenRoman && moveGenKey && (
                            <a href={pagePath(lang as string, 'generacion', String(moveGenNumRaw))} class="px-5 py-2 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] bg-slate-100 dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:bg-emerald-500 hover:text-white transition-all no-underline">
                                {t.generation_label} {moveGenRoman}
                            </a>
                        )}
                    </div>
                    <h1 class="text-6xl font-black text-slate-900 dark:text-white mb-2 capitalize leading-tight tracking-tighter">{localizedName}</h1>
                    <div class="mb-6"><ReportDataIssue entityType="move" entitySlug={moveData.name} lang={lang as string} /></div>
                    <div class="bg-emerald-50/50 dark:bg-emerald-950/10 rounded-3xl p-8 border border-emerald-100/50 dark:border-emerald-900/20">
                        <p class="text-xl text-slate-700 dark:text-slate-300 leading-relaxed italic font-medium">
                            {description.source === 'flavor' ? `"${description.text}"` : description.text}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Panel de Datos Técnicos -->
            <div class="md:col-span-4">
                <div class="bg-emerald-600 dark:bg-emerald-500 rounded-[3.5rem] p-10 shadow-2xl shadow-emerald-200 dark:shadow-black/50 h-full flex flex-col justify-between text-white transition-all duration-300">
                    <div class="space-y-8">
                        <div class="flex justify-between items-end border-b border-emerald-500/30 pb-4">
                            <div>
                                <p class="text-emerald-100/70 text-[10px] font-black uppercase tracking-widest mb-1">{t.power}</p>
                                <p class="text-4xl font-black">{moveData.power || '—'}</p>
                            </div>
                            <div class="p-3 bg-white/10 rounded-2xl backdrop-blur-sm" aria-hidden="true">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            </div>
                        </div>
                        <div class="flex justify-between items-end border-b border-emerald-500/30 pb-4">
                            <div>
                                <p class="text-emerald-100/70 text-[10px] font-black uppercase tracking-widest mb-1">{t.accuracy}</p>
                                <p class="text-4xl font-black">{moveData.accuracy ? `${moveData.accuracy}%` : '—'}</p>
                            </div>
                            <div class="p-3 bg-white/10 rounded-2xl backdrop-blur-sm" aria-hidden="true">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                        </div>
                        <div class="flex justify-between items-end border-b border-emerald-500/30 pb-4">
                            <div>
                                <p class="text-emerald-100/70 text-[10px] font-black uppercase tracking-widest mb-1">{t.priority}</p>
                                <p class={`text-4xl font-black ${moveData.priority > 0 ? 'text-white' : moveData.priority < 0 ? 'text-rose-200' : 'text-emerald-100'}`}>
                                    {moveData.priority > 0 ? `+${moveData.priority}` : moveData.priority}
                                </p>
                            </div>
                            <div class="p-3 bg-white/10 rounded-2xl backdrop-blur-sm">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                        </div>
                        <div class="flex justify-between items-end border-b border-emerald-500/30 pb-4">
                            <div>
                                <p class="text-emerald-100/70 text-[10px] font-black uppercase tracking-widest mb-1">{t.pp}</p>
                                <p class="text-4xl font-black">{moveData.pp}</p>
                            </div>
                            <div class="p-3 bg-white/10 rounded-2xl backdrop-blur-sm">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path></svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {(mechanics.ailment || mechanics.drain || mechanics.recoil || mechanics.healing || mechanics.critRate || mechanics.flinchChance || mechanics.minHits || mechanics.minTurns || mechanics.statChanges.length > 0) && (
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm mb-16">
                <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.mechanics}</h2>
                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4 text-sm">
                    <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_target}</dt><dd class="text-slate-900 dark:text-white font-black text-right">{targetLabel(mechanics.target, lang as string)}</dd></div>
                    {mechanics.ailment && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_ailment}</dt><dd class="text-slate-900 dark:text-white font-black text-right">{ailmentLabel(mechanics.ailment, lang as string)}{mechanics.ailmentChance ? ` (${mechanics.ailmentChance}%)` : ''}</dd></div>
                    )}
                    {mechanics.drain != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_drain}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.drain}%</dd></div>
                    )}
                    {mechanics.recoil != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_recoil}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.recoil}%</dd></div>
                    )}
                    {mechanics.healing != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_healing}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.healing}%</dd></div>
                    )}
                    {mechanics.critRate != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_crit_rate}</dt><dd class="text-slate-900 dark:text-white font-black">+{mechanics.critRate}</dd></div>
                    )}
                    {mechanics.flinchChance != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_flinch_chance}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.flinchChance}%</dd></div>
                    )}
                    {mechanics.minHits != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_hits}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.minHits === mechanics.maxHits ? mechanics.minHits : `${mechanics.minHits}–${mechanics.maxHits}`}</dd></div>
                    )}
                    {mechanics.minTurns != null && (
                        <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_turns}</dt><dd class="text-slate-900 dark:text-white font-black">{mechanics.minTurns === mechanics.maxTurns ? mechanics.minTurns : `${mechanics.minTurns}–${mechanics.maxTurns}`}</dd></div>
                    )}
                    {mechanics.statChanges.length > 0 && (
                        <div class="sm:col-span-2 flex justify-between gap-4">
                            <dt class="text-slate-500 dark:text-slate-400 font-bold">{t.move_stat_changes}</dt>
                            <dd class="text-slate-900 dark:text-white font-black text-right">
                                {mechanics.statChanges.map((s) => `${t[s.stat] || s.stat} ${s.change > 0 ? '+' : ''}${s.change}`).join(', ')}
                                {mechanics.statChance ? ` (${mechanics.statChance}%)` : ''}
                            </dd>
                        </div>
                    )}
                </dl>
            </div>
        )}

        {machines.length > 0 && (
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm mb-16">
                <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.machines_section}</h2>
                <ul class="flex flex-wrap gap-2 text-xs list-none p-0 m-0">
                    {machines.slice(0, MACHINES_VISIBLE).map((m) => (
                        <li class="px-3 py-1.5 bg-slate-50 dark:bg-slate-800/50 rounded-xl font-bold text-slate-600 dark:text-slate-300">{m.itemLabel} · {m.versionGroupLabel}</li>
                    ))}
                </ul>
                {machines.length > MACHINES_VISIBLE && (
                    <details class="mt-3">
                        <summary class="text-xs font-bold text-emerald-600 dark:text-emerald-400 cursor-pointer">{lang === 'es' ? `Ver ${machines.length - MACHINES_VISIBLE} más` : `Show ${machines.length - MACHINES_VISIBLE} more`}</summary>
                        <ul class="flex flex-wrap gap-2 text-xs list-none p-0 mt-3">
                            {machines.slice(MACHINES_VISIBLE).map((m) => (
                                <li class="px-3 py-1.5 bg-slate-50 dark:bg-slate-800/50 rounded-xl font-bold text-slate-600 dark:text-slate-300">{m.itemLabel} · {m.versionGroupLabel}</li>
                            ))}
                        </ul>
                    </details>
                )}
            </div>
        )}

        {pastValues.length > 0 && (
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm mb-16">
                <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.move_history}</h2>
                <ul class="space-y-3 text-sm list-none p-0 m-0">
                    {pastValues.map((v) => {
                        const parts: string[] = [];
                        if (v.power != null) parts.push(`${t.power} ${v.power}`);
                        if (v.accuracy != null) parts.push(`${t.accuracy} ${v.accuracy}%`);
                        if (v.pp != null) parts.push(`PP ${v.pp}`);
                        if (v.type) parts.push(`${t.pokemon_types}: ${typeTranslations[lang as string]?.[v.type] || formatName(v.type)}`);
                        return (
                            <li class="text-slate-600 dark:text-slate-400">
                                <span class="font-black text-slate-900 dark:text-white">{versionGroupLabel(v.versionGroup, lang as string)}{lang === 'es' ? ' y anteriores' : ' and earlier'}:</span> {parts.join(', ')}
                            </li>
                        );
                    })}
                </ul>
            </div>
        )}

        <h2 class="text-3xl font-black text-slate-900 dark:text-white mb-10 px-4 flex items-center gap-4">
            <span class="w-2 h-8 bg-emerald-500 rounded-full"></span>
            {t.pokemon_with_move}
            <span class="text-sm font-bold text-slate-400 dark:text-slate-600 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-full border border-slate-200/50 dark:border-slate-700">{totalLearnedBy}</span>
            {totalLearnedBy > pokemonList.length && (
                <span class="text-xs font-bold text-slate-400 dark:text-slate-600">{lang === 'es' ? `Mostrando ${pokemonList.length}` : `Showing ${pokemonList.length}`}</span>
            )}
        </h2>

        <PokemonRelationList entries={pokemonList.map((pokemon) => ({ pokemon }))} lang={lang as string} />
    </div>
</Layout>
