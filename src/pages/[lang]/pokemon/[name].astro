---
import Layout from '../../../layouts/Layout.astro';
import MovesTable from '../../../components/MovesTable.astro';
import EvolutionChain from '../../../components/EvolutionChain.astro';
import SmogonTier from '../../../components/SmogonTier.astro';
import ReportDataIssue from '../../../components/ReportDataIssue.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getPokemonByName, getLocalizedName, getEvolutionChain, getAbilityDetail, getAllAbilities, getPokemonDetailByUrl, getPokemonSummaryByUrl, getSpeciesNamesById, idFromResourceUrl, GENERATION_ROMAN, type PokemonDetail } from '../../../services/pokeapi';
import { getShowdownPokemon } from '../../../services/smogon';
import { buildAbilityIndex, abilitySlugOrNull, type AbilityIndex } from '../../../utils/abilitySlug';
import { uiTranslations, typeTranslations, typeColors, formatPokemonNumber, formatName, buildPokeTypesUrl } from '../../../utils/pokemon';
import { canonicalPokemonSlug, pagePath } from '../../../utils/seo';
import { buildPokemonFacts, growthRateLabel, eggGroupLabel, localizedGenus, regionalDexEntriesForContext, pastStatChanges } from '../../../utils/pokemonFacts';
import { pokedexLabel } from '../../../services/pokedexes';
import { versionGroupsFromMoveDetails, jsonForScript } from '../../../utils/movesPayload';
import { availableContextsForPokemon, defaultGameContextForPokemon } from '../../../services/gameContext';

const { lang = 'es', name: rawName } = Astro.params;
const name = (rawName as string || '').toLowerCase();

// Optional enrichment that doesn't depend on the primary lookup starts now,
// so its latency (Showdown's pokedex is the slowest call on this page,
// ~0.7 s cold) overlaps pokemon/{name} -> species instead of following them.
// Both are failure-tolerant by construction (they resolve to null), so a
// request that ends in a 404/redirect/503 leaves nothing unhandled.
const showdownPromise = getShowdownPokemon(name).catch(() => null);
const abilityIndexPromise: Promise<AbilityIndex | null> = getAllAbilities()
    .then((abilities) => buildAbilityIndex(abilities.map((a) => a.name)))
    .catch(() => null);

// Only this primary lookup can 404 the page (EntityNotFoundError). An
// UpstreamError or a missing related resource is answered 503 by
// src/middleware.ts; any other error surfaces as a real 500.
const pokemonData = await getPokemonByName(name);
const detail: any = pokemonData.detail;
const species: any = pokemonData.species;

// One URL per Pokémon: a numeric id (/160/), a case variant (/Feraligatr/)
// or a species' default form (/basculin-red-striped/) all 301 to the
// canonical slug. Only the canonical request renders.
const canonicalSlug = canonicalPokemonSlug(detail);
if (rawName !== canonicalSlug) {
    return Astro.redirect(pagePath(lang, 'pokemon', canonicalSlug), 301);
}

// Inicializar arrays para evitar errores de undefined
detail.abilities = detail.abilities || [];
detail.moves = detail.moves || [];
detail.stats = detail.stats || [];
detail.types = detail.types || [];

// Species-dependent enrichment, started before Showdown/Smogon resolve (each
// is independent of them and optional: a failure leaves it null / empty).
const evolutionPromise = species?.evolution_chain?.url
    ? getEvolutionChain(species.evolution_chain.url).catch(() => null)
    : Promise.resolve(null);
const varietiesPromise: Promise<any[]> = species?.varieties
    ? Promise.all(species.varieties.filter((v: any) => !v.is_default).map((v: any) => getPokemonSummaryByUrl(v.pokemon.url)))
        .then((list) => list.filter(Boolean))
        .catch(() => [])
    : Promise.resolve([]);
// Previous / next in the National Dex: from the species list (name + id, one
// cached request shared by the whole site) instead of two full pokemon/{id}
// objects (~280 KB each) fetched for a name and a sprite.
const currentDexIdEarly = detail.id > 10000 ? Number(detail.species?.url?.match(/\/pokemon-species\/(\d+)\//)?.[1] ?? detail.id) : detail.id;
const speciesNamesPromise: Promise<Map<number, string> | null> = getSpeciesNamesById().catch(() => null);

// 1. Enriquecer con Showdown
let showdownData: any = null;
try {
    showdownData = await showdownPromise;
    if (showdownData) {
        // Habilidades desde Showdown (Fuente principal de verdad técnica)
        // La key "H" en el objeto de Showdown indica habilidad oculta
        if (showdownData.abilities) {
            // Showdown names ("Mind's Eye") are resolved against PokeAPI's real
            // ability slugs ("minds-eye"). Optional dependency: if the catalog is
            // unavailable, or a name matches no single entity, no slug is guessed
            // and the ability is shown by its Showdown name without a link.
            const abilityIndex = await abilityIndexPromise;
            detail.abilities = Object.entries(showdownData.abilities)
                .filter(([, abilityName]) => typeof abilityName === 'string' && abilityName.trim() !== '')
                .map(([key, abilityName]: [string, any]) => {
                    const slug = abilityIndex ? abilitySlugOrNull(abilityName, abilityIndex) : null;
                    return {
                        ability: {
                            name: slug ?? abilityName,
                            url: slug ? `https://pokeapi.co/api/v2/ability/${slug}` : '',
                            unresolved: !slug,
                        },
                        is_hidden: key === 'H',
                        slot: key === 'H' ? 3 : parseInt(key) + 1
                    };
                });
        }

        // Tipos desde Showdown
        if (showdownData.types && showdownData.types.length > 0) {
            detail.types = showdownData.types.map((typeName: string, index: number) => ({
                slot: index + 1,
                type: {
                    name: typeName.toLowerCase(),
                    url: `https://pokeapi.co/api/v2/type/${typeName.toLowerCase()}/`
                }
            }));
        }

        // Stats desde Showdown
        if (showdownData.baseStats) {
            const statMap: Record<string, string> = { hp: 'hp', atk: 'attack', def: 'defense', spa: 'special-attack', spd: 'special-defense', spe: 'speed' };
            detail.stats = detail.stats.map((s: PokemonDetail['stats'][number]) => {
                const showdownKey = Object.keys(statMap).find(key => statMap[key] === s.stat.name);
                return { ...s, base_stat: (showdownKey && showdownData.baseStats[showdownKey]) ? showdownData.baseStats[showdownKey] : s.base_stat };
            });
        }
    }
} catch (e) {}

// 2. Fallback de especie (para Movimientos que Showdown no detalla para Megas)
if (detail.moves.length === 0 || detail.abilities.length === 0) {
    const baseVariety = species?.varieties?.find((v: any) => v.is_default);
    if (baseVariety && baseVariety.pokemon.name !== detail.name) {
        try {
            const baseDetail = await getPokemonDetailByUrl(baseVariety.pokemon.url);
            if (baseDetail) {
                if (detail.abilities.length === 0) detail.abilities = baseDetail.abilities || [];
                if (detail.moves.length === 0) detail.moves = baseDetail.moves || [];
            }
        } catch (e) {}
    }
}

// 3. Datos Técnicos
let evolutionChain: any = null;
let abilitiesWithTranslation: any[] = [];
let varieties: any[] = [];

try {
    abilitiesWithTranslation = await Promise.all(detail.abilities.map(async (a: any) => {
        try {
            if (!a.ability.url) throw new Error('unresolved ability');
            const ad = await getAbilityDetail(a.ability.url);
            return {
                ...a,
                displayName: ad.names?.find((n: any) => n.language.name === lang)?.name || formatName(a.ability.name),
                description: ad.flavor_text_entries?.find((f: any) => f.language.name === lang)?.flavor_text.replace(/\f/g, ' ') ||
                             ad.flavor_text_entries?.find((f: any) => f.language.name === 'en')?.flavor_text.replace(/\f/g, ' ') || ""
            };
        } catch (e) {
            return { ...a, displayName: formatName(a.ability.name), description: "" };
        }
    }));
} catch (e) {}
[evolutionChain, varieties] = await Promise.all([evolutionPromise, varietiesPromise]);

const t = uiTranslations[lang as string] || uiTranslations.es;
const speciesName = species ? (getLocalizedName(species.names, lang as string) || species.name) : detail.name;
let localizedName = speciesName;

if (species && detail.name !== species.name) {
    const suffix = detail.name.replace(species.name, '').replace(/-/g, ' ').trim();
    if (suffix) {
        const suffixMap: Record<string, string> = {
            'gmax': lang === 'es' ? 'Gigamax' : 'G-Max', 'mega': 'Mega', 'alola': 'Alola', 'galar': 'Galar', 'hisui': 'Hisui', 'paldea': 'Paldea', 'mega x': 'Mega X', 'mega y': 'Mega Y'
        };
        localizedName = `${speciesName} (${suffixMap[suffix.toLowerCase()] || formatName(suffix)})`;
    }
}

const description = species?.flavor_text_entries?.find((entry: any) => entry.language.name === lang)?.flavor_text.replace(/\f/g, ' ') || 
                  species?.flavor_text_entries?.find((entry: any) => entry.language.name === (lang === 'es' ? 'en' : 'es'))?.flavor_text.replace(/\f/g, ' ') || "";

const pokemonId = detail.id;
const officialArtwork = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${pokemonId}.png`;
const officialArtworkShiny = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/${pokemonId}.png`;

const height = detail.height / 10;
const weight = detail.weight / 10;
const totalStats = detail.stats.reduce((acc: number, s: any) => acc + s.base_stat, 0);

// Lógica para Navegación Anterior/Siguiente (Dex Nacional). The species id
// comes from the species link already on the detail; the wrap-around bound is
// the species list's own size, not a hardcoded 1025.
const currentDexId = currentDexIdEarly;
const speciesNamesById = await speciesNamesPromise;
const maxDexId = speciesNamesById ? Math.max(...speciesNamesById.keys()) : 0;
const prevId = currentDexId === 1 ? maxDexId : currentDexId - 1;
const nextId = currentDexId === maxDexId ? 1 : currentDexId + 1;

const navEntry = (id: number) => {
    const speciesName = speciesNamesById?.get(id);
    return speciesName
        ? { name: speciesName, sprites: { front_default: `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${id}.png` } }
        : null;
};
// Optional enrichment: without the species list there is no navigation block.
const prevPokemon: any = speciesNamesById ? navEntry(prevId) : null;
const nextPokemon: any = speciesNamesById ? navEntry(nextId) : null;

const hasNavigation = prevPokemon && nextPokemon;

const statsValues = detail.stats.map((s: any) => s.base_stat);
const angleStep = (Math.PI * 2) / 6;
const radius = 80;
const center = 125;
const points = statsValues.map((stat: number, i: number) => {
    const r = (Math.min(stat, 180) / 180) * radius; 
    const x = center + r * Math.sin(i * angleStep);
    const y = center - r * Math.cos(i * angleStep);
    return `${x},${y}`;
}).join(' ');

const statLabels = [t.stat_hp, t.stat_atk, t.stat_def, t.stat_spatk, t.stat_spdef, t.stat_spd];
const gridLevels = [0.25, 0.5, 0.75, 1];
const seoTitle = lang === 'es'
    ? `${localizedName}: Stats, Movimientos y Habilidades`
    : `${localizedName}: Stats, Moves & Abilities`;
const seoDescription = lang === 'es'
    ? `Ficha de ${localizedName}: tipos, estadísticas base (${totalStats}), habilidades, evolución y movimientos que aprende.`
    : `${localizedName} profile: types, base stats (${totalStats}), abilities, evolution and the moves it learns.`;

// Type theming
const primaryType = detail.types[0]?.type.name || 'normal';
const typeColor = (typeColors as Record<string, string>)[primaryType] || '#10b981';
const hexToRgba = (hex: string, alpha: number): string => {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return `rgba(${r},${g},${b},${alpha})`;
};
const typeColorBg = hexToRgba(typeColor, 0.08);
const typeColorFill = hexToRgba(typeColor, 0.2);
const typeColorBorder = hexToRgba(typeColor, 0.35);

const getStatBarColor = (baseStat: number): string => {
    if (baseStat < 70) return '#f87171';
    if (baseStat < 100) return '#fbbf24';
    return typeColor;
};

// Generation link — species already carries its own generation (PokeAPI's
// pokemon-species resource has a `generation` field), so this is free: no
// extra fetch, no static id-range table, and it can't drift out of sync
// with PokeAPI the way a hand-maintained range could (see Gen 9 fix in
// getPokemonByGeneration).
const pokemonGenNumRaw = species?.generation?.url ? idFromResourceUrl(species.generation.url) : null;
const pokemonGenKey = pokemonGenNumRaw ? `gen${pokemonGenNumRaw}` : null;
const pokemonGenRoman = pokemonGenKey ? GENERATION_ROMAN[pokemonGenKey] : null;
const pokemonGenNum = pokemonGenNumRaw ? String(pokemonGenNumRaw) : null;

// Factual data (training, breeding, classification, regional Pokédex
// numbers): normalized once here from `detail`/`species` — both already in
// hand, no extra request — and rendered as-is by the template. See
// docs/architecture/pokemon-entity.md.
const facts = buildPokemonFacts(detail, species);
const genus = localizedGenus(species?.genera || [], lang as string);

// Fase 2F: real historical stat/EV-yield changes (PokeAPI's past_stats —
// see utils/pokemonFacts.ts and docs/architecture/pokemon-entity.md §8 for
// why base_happiness/capture_rate/base_experience have no equivalent and
// stay as the current-only values shown above). Already in `detail`, no
// extra request.
const statHistory = pastStatChanges(detail.past_stats);

// Game Context (Fase 2E): computed once, here, from this Pokémon's own
// moves — the SAME derivation MovesTable uses internally — and handed
// down to it as props so the page has exactly one Game Context
// computation, never two independent ones. The regional Pokédex section
// below reuses this same result to filter its entries; MovesTable's own
// <select> stays the only Game Context control on the page (see its
// client script for the `pokepedia:game-context-change` broadcast this
// section listens for).
const pokemonVersionGroups = versionGroupsFromMoveDetails(detail.moves);
const availableContexts = availableContextsForPokemon(pokemonVersionGroups);
const defaultContext = defaultGameContextForPokemon(pokemonVersionGroups);
const defaultContextAvailability = availableContexts.find((a) => a.context.id === defaultContext.contextId);
const defaultRevisions = defaultContextAvailability?.availableRevisions ?? (defaultContext.revision ? [defaultContext.revision] : []);

// Regional Pokédex numbers, filtered to the default Game Context — SSR is
// correct from the start, never "show everything, JS narrows it later".
// No available context at all (no recognized version groups) means there
// is nothing to filter *by*, not that every entry is out of scope: show
// every historical entry unfiltered rather than hiding real data.
const defaultRegionalDex = availableContexts.length > 0
    ? regionalDexEntriesForContext(facts.regionalDex, defaultRevisions)
    : facts.regionalDex;
const regionalDexHistoricalCount = facts.regionalDex.length;

const breadcrumbItems = [
    { label: t.breadcrumb_home, href: pagePath(lang) },
    { label: 'Pokédex', href: pagePath(lang) },
    { label: localizedName },
];
---

<Layout
    title={seoTitle}
    description={seoDescription}
    image={`/og/v1/${lang}/pokemon/${detail.name}.png/`}
    imageAlt={localizedName}
    lang={lang as string}
>
    <div class="max-w-5xl mx-auto">
        <Breadcrumbs items={breadcrumbItems} />
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-12">
            <div class="flex flex-col gap-4">
                <a href={pagePath(lang)} class="inline-flex items-center gap-2 text-slate-500 dark:text-slate-400 hover:text-emerald-500 font-bold transition-colors group">
                    <div class="w-10 h-10 rounded-xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 flex items-center justify-center group-hover:border-emerald-500/30 shadow-sm">
                        <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                    </div>
                    {t.back_to_pokedex}
                </a>
                <div class="flex items-center gap-4 flex-wrap">
                    <h1 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white capitalize tracking-tighter">{localizedName}</h1>
                    <button class="fav-btn p-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 text-slate-400" data-pokemon={name} onclick="window.toggleFavorite(this.dataset.pokemon)">
                        <svg class="w-6 h-6 heart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"></path></svg>
                    </button>
                    {facts.classification.isLegendary && <span class="px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest bg-amber-100 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-200/60 dark:border-amber-500/20">{t.legendary_pokemon}</span>}
                    {facts.classification.isMythical && <span class="px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest bg-violet-100 dark:bg-violet-500/10 text-violet-600 dark:text-violet-400 border border-violet-200/60 dark:border-violet-500/20">{t.mythical_pokemon}</span>}
                    {facts.classification.isBaby && <span class="px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest bg-sky-100 dark:bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-200/60 dark:border-sky-500/20">{t.baby_pokemon}</span>}
                </div>
                {genus && (
                    <p class="text-sm font-bold text-slate-400 dark:text-slate-500 -mt-2">
                        <span class="uppercase tracking-wide text-[11px] text-slate-400/80 dark:text-slate-500/80">{t.category}:</span> {genus}
                    </p>
                )}
                <ReportDataIssue entityType="pokemon" entitySlug={detail.name} lang={lang as string} />
            </div>

            <div class="flex items-center gap-3">
                {hasNavigation ? (
                    <>
                        <a href={pagePath(lang, 'pokemon', prevPokemon.name)} class="flex items-center gap-3 pl-2 pr-4 py-2 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl group no-underline">
                            <img src={prevPokemon.sprites?.front_default} alt="" width="40" height="40" class="w-10 h-10 object-contain group-hover:scale-110 transition-transform" />
                            <div class="flex flex-col">
                                <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest leading-none mb-1">#{prevId.toString().padStart(4, '0')}</span>
                                <span class="text-xs font-bold text-slate-700 dark:text-slate-200 capitalize leading-none">{prevPokemon.name.replace(/-/g, ' ')}</span>
                            </div>
                        </a>
                        <div class="w-px h-8 bg-slate-100 dark:bg-slate-800 hidden sm:block"></div>
                        <a href={pagePath(lang, 'pokemon', nextPokemon.name)} class="flex items-center gap-3 pl-4 pr-2 py-2 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-2xl group no-underline text-right">
                            <div class="flex flex-col">
                                <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest leading-none mb-1">#{nextId.toString().padStart(4, '0')}</span>
                                <span class="text-xs font-bold text-slate-700 dark:text-slate-200 capitalize leading-none">{nextPokemon.name.replace(/-/g, ' ')}</span>
                            </div>
                            <img src={nextPokemon.sprites?.front_default} alt="" width="40" height="40" class="w-10 h-10 object-contain group-hover:scale-110 transition-transform" />
                        </a>
                    </>
                ) : <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest bg-slate-100 dark:bg-slate-800 px-4 py-2 rounded-xl">{t.navigation_unavailable || 'Navigation unavailable'}</div>}
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
            <div class="md:col-span-5 flex flex-col items-center">
                <div class="relative w-full aspect-square bg-white dark:bg-slate-900 rounded-[3rem] shadow-xl overflow-hidden flex items-center justify-center p-12 mb-8" style={`border: 2px solid ${typeColorBorder}`}>
                    <img id="pokemon-image" src={officialArtwork} data-default={officialArtwork} data-shiny={officialArtworkShiny} alt={localizedName} class="relative z-10 w-full h-full object-contain drop-shadow-2xl transition-all duration-500" />
                    <span class="absolute top-8 right-8 z-10 text-2xl font-black text-slate-200 dark:text-slate-800">{formatPokemonNumber(pokemonId)}</span>
                    <button id="shiny-toggle" class="absolute bottom-6 right-6 z-10 p-3 bg-white dark:bg-slate-800 rounded-2xl shadow-lg border border-slate-100 text-slate-400 hover:text-amber-500 transition-all"><svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg></button>
                    <!-- Ambient type glow — last in DOM, no z-index → behind z-10 siblings -->
                    <div class="absolute inset-0 pointer-events-none" style={`background: radial-gradient(ellipse at 50% 65%, ${typeColorBg} 0%, transparent 70%)`} aria-hidden="true"></div>
                </div>
                <div class="w-full bg-white dark:bg-slate-900 rounded-3xl p-8 border border-slate-100 dark:border-slate-800 shadow-sm">
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.basic_info}</h3>
                    <div class="grid grid-cols-2 gap-6">
                        <div><p class="text-slate-400 text-xs font-bold uppercase mb-1">{t.height}</p><p class="text-slate-900 dark:text-white font-bold text-lg">{height} m</p></div>
                        <div><p class="text-slate-400 text-xs font-bold uppercase mb-1">{t.weight}</p><p class="text-slate-900 dark:text-white font-bold text-lg">{weight} kg</p></div>
                        <div class="col-span-2 border-t border-slate-50 dark:border-slate-800 pt-6 mt-2">
                            <p class="text-slate-400 text-xs font-bold uppercase mb-1">{t.abilities}</p>
                            <div class="space-y-3 mt-3">
                                {abilitiesWithTranslation.map((a: any) => {
                                    // A Showdown name that matched no PokeAPI ability has no page to link to.
                                    const Card = a.ability.unresolved ? 'div' : 'a';
                                    return (
                                    <Card href={a.ability.unresolved ? undefined : pagePath(lang, 'habilidades', a.ability.name)} class="block bg-slate-50 dark:bg-slate-800 rounded-2xl p-4 border border-slate-100 dark:border-slate-700 hover:border-emerald-500/50 hover:bg-white dark:hover:bg-slate-700/50 transition-all group/ability no-underline">
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-sm font-bold text-emerald-600 dark:text-emerald-400 group-hover/ability:underline">
                                                {a.displayName}
                                            </span>
                                            {a.is_hidden && <span class="text-[10px] font-bold uppercase tracking-widest bg-slate-200 dark:bg-slate-700 text-slate-500 px-2 py-0.5 rounded-md">{t.hidden}</span>}
                                        </div>
                                        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed italic">{a.description}</p>
                                    </Card>
                                    );
                                })}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="md:col-span-7 space-y-12">
                <div class="flex flex-wrap items-center gap-4 mb-6">
                    <div class="flex gap-2">
                        {detail.types.map((t2: any) => (
                            <a href={pagePath(lang, 'tipo', t2.type.name)} data-track-event="internal_entity_click" data-entity-type="type" data-entity-slug={t2.type.name} data-source-surface="pokemon_detail" class="px-4 py-1.5 rounded-xl text-xs font-black uppercase tracking-widest text-white shadow-sm hover:opacity-90 transition-opacity no-underline" style={`background-color: ${typeColors[t2.type.name]}`}>{typeTranslations[lang as string][t2.type.name]}</a>
                        ))}
                    </div>
                    {pokemonGenRoman && pokemonGenNum && (
                        <a href={pagePath(lang, 'generacion', pokemonGenNum)} data-track-event="internal_entity_click" data-entity-type="generation" data-entity-slug={pokemonGenKey} data-source-surface="pokemon_detail" class="px-4 py-1.5 rounded-xl text-xs font-black uppercase tracking-widest bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-emerald-500 hover:text-white transition-all no-underline">
                            {t.generation_label} {pokemonGenRoman}
                        </a>
                    )}
                    <a href={buildPokeTypesUrl(detail.types, detail.name)} target="_blank" rel="noopener noreferrer" data-track-event="cross_site_click" data-track-target="poketypes" data-source-surface="pokemon_detail" class="group relative inline-flex items-center gap-3 px-5 py-2 rounded-xl bg-emerald-500/10 border-2 border-emerald-500/20 hover:border-emerald-500 transition-all no-underline">
                        <span class="text-[10px] font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest">{t.view_types_on_poketypes}</span>
                    </a>
                </div>
                <h2 class="text-3xl sm:text-4xl md:text-6xl font-black text-slate-900 dark:text-white capitalize mb-4 break-words">{localizedName}</h2>
                <p class="text-xl text-slate-600 dark:text-slate-400 leading-relaxed italic">"{description}"</p>

                <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm mb-12">
                    <div class="flex justify-between items-center mb-10"><h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest">{t.base_stats}</h3><div class="flex items-center gap-2"><span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">{t.total}</span><span class="text-2xl font-black text-slate-900 dark:text-white tracking-tighter">{totalStats}</span></div></div>
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                        <div class="lg:col-span-5 relative flex justify-center">
                            <svg viewBox="0 0 250 250" class="w-full max-w-[280px] drop-shadow-2xl overflow-visible">
                                {gridLevels.map(level => (
                                    <polygon points={Array.from({length: 6}).map((_, i) => { const r = level * radius; const x = center + r * Math.sin(i * angleStep); const y = center - r * Math.cos(i * angleStep); return `${x},${y}`; }).join(' ')} class="fill-none stroke-slate-200 dark:stroke-slate-800" stroke-width="1" />
                                ))}
                                {Array.from({length: 6}).map((_, i) => (
                                    <line x1={center} y1={center} x2={center + radius * Math.sin(i * angleStep)} y2={center - radius * Math.cos(i * angleStep)} class="stroke-slate-200 dark:stroke-slate-800" stroke-width="1" />
                                ))}
                                {statLabels.map((label, i) => { 
                                    const r = radius + 25; 
                                    const x = center + r * Math.sin(i * angleStep); 
                                    const y = center - r * Math.cos(i * angleStep); 
                                    return <text x={x} y={y} text-anchor="middle" dominant-baseline="middle" class="fill-slate-400 dark:fill-slate-500 text-[10px] font-black tracking-tighter">{label}</text>; 
                                })}
                                <polygon points={points} fill={typeColorFill} stroke={typeColor} stroke-width="3" stroke-linejoin="round" />
                                {points.split(' ').map((p: string) => (
                                    <circle cx={p.split(',')[0]} cy={p.split(',')[1]} r="3" fill={typeColor} />
                                ))}
                            </svg>
                        </div>
                        <div class="lg:col-span-7 space-y-4">
                            {detail.stats.map((s: any) => {
                                const percentage = (s.base_stat / 255) * 100;
                                const barColor = getStatBarColor(s.base_stat);
                                return (
                                    <div>
                                        <div class="flex justify-between mb-1 text-sm font-bold"><span class="text-slate-500 dark:text-slate-400 uppercase tracking-wider">{t[s.stat.name] || s.stat.name}</span><span class="text-slate-900 dark:text-white">{s.base_stat}</span></div>
                                        <div class="w-full bg-slate-100 dark:bg-slate-800 rounded-full h-2 overflow-hidden"><div class="h-full rounded-full transition-all duration-1000" style={`width: ${percentage}%; background-color: ${barColor}`}></div></div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </div>

                <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm grid grid-cols-1 sm:grid-cols-2 gap-10">
                    <section>
                        <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.training}</h2>
                        <dl class="space-y-4 text-sm">
                            {facts.training.baseExperience != null && (
                                <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.base_experience}</dt><dd class="text-slate-900 dark:text-white font-black">{facts.training.baseExperience}</dd></div>
                            )}
                            {facts.training.captureRate != null && (
                                <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.capture_rate}</dt><dd class="text-slate-900 dark:text-white font-black">{facts.training.captureRate}</dd></div>
                            )}
                            {facts.training.baseHappiness != null && (
                                <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.base_happiness}</dt><dd class="text-slate-900 dark:text-white font-black">{facts.training.baseHappiness}</dd></div>
                            )}
                            {facts.training.growthRate && (
                                <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.growth_rate}</dt><dd class="text-slate-900 dark:text-white font-black capitalize">{growthRateLabel(facts.training.growthRate, lang as string)}</dd></div>
                            )}
                            {facts.training.evYield.length > 0 && (
                                <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.ev_yield}</dt><dd class="text-slate-900 dark:text-white font-black text-right">{facts.training.evYield.map((e) => `${e.amount} ${t[e.stat] || e.stat}`).join(' + ')}</dd></div>
                            )}
                        </dl>
                    </section>
                    <section>
                        <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.breeding}</h2>
                        <dl class="space-y-4 text-sm">
                            {facts.breeding.eggGroups.length > 0 && (
                                <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.egg_groups}</dt><dd class="text-slate-900 dark:text-white font-black text-right">{facts.breeding.eggGroups.map((g) => eggGroupLabel(g, lang as string)).join(', ')}</dd></div>
                            )}
                            <div class="flex justify-between gap-4">
                                <dt class="text-slate-500 dark:text-slate-400 font-bold">{t.gender_ratio}</dt>
                                <dd class="text-slate-900 dark:text-white font-black">
                                    {facts.breeding.gender.genderless
                                        ? t.genderless
                                        : `♂ ${facts.breeding.gender.malePercent}% · ♀ ${facts.breeding.gender.femalePercent}%`}
                                </dd>
                            </div>
                            {facts.breeding.hatchCounter != null && (
                                <div class="flex justify-between gap-4"><dt class="text-slate-500 dark:text-slate-400 font-bold">{t.hatch_cycles}</dt><dd class="text-slate-900 dark:text-white font-black">{facts.breeding.hatchCounter}</dd></div>
                            )}
                        </dl>
                    </section>
                </div>

                {facts.regionalDex.length > 0 && (
                    <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm">
                        <div class="flex flex-wrap items-center gap-3 mb-6">
                            <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest">{t.pokedex_numbers}</h2>
                            <!--
                              Always rendered, never SSR-conditional (Fase 2D
                              lesson, see docs/architecture/game-context.md):
                              visibility is a `hidden` class the client
                              toggles on every Game Context change, which an
                              element omitted from the DOM outright could
                              never react to. Always means the same thing —
                              distinct historical Pokédex entries across
                              every Game Context, never scoped to "this
                              context's method" (there is no method concept
                              here, but the honesty principle is the same).
                            -->
                            <span id="regional-dex-historical" class:list={['text-xs font-bold text-slate-400 dark:text-slate-600', { hidden: regionalDexHistoricalCount <= defaultRegionalDex.length }]}>{t.learnset_total_historical}: {regionalDexHistoricalCount}</span>
                        </div>
                        <dl id="regional-dex-list" class:list={['grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-sm', { hidden: defaultRegionalDex.length === 0 }]}>
                            {defaultRegionalDex.map((entry) => (
                                <div class="flex items-start justify-between gap-3 bg-slate-50 dark:bg-slate-800/50 rounded-xl px-4 py-3">
                                    <dt class="text-slate-500 dark:text-slate-400 font-bold leading-snug">{pokedexLabel(entry.pokedex, lang as string)}</dt>
                                    <dd class="text-slate-900 dark:text-white font-black shrink-0 whitespace-nowrap">#{String(entry.entryNumber).padStart(3, '0')}</dd>
                                </div>
                            ))}
                        </dl>
                        <div id="regional-dex-empty" class:list={['p-8 text-center text-slate-400 dark:text-slate-600 font-bold text-sm', { hidden: defaultRegionalDex.length > 0 }]}>{t.regional_dex_no_results}</div>
                        <script type="application/json" id="regional-dex-data" is:inline set:html={jsonForScript({
                            entries: facts.regionalDex.map((e) => [e.pokedex, e.entryNumber]),
                            contexts: availableContexts.map((a) => ({ id: a.context.id, revisions: a.availableRevisions })),
                            initialContext: defaultContext.contextId,
                        })} />
                    </div>
                )}

                {statHistory.length > 0 && (
                    <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm">
                        <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.move_history}</h2>
                        <ul class="space-y-3 text-sm list-none p-0 m-0">
                            {statHistory.map((entry) => (
                                <li class="text-slate-600 dark:text-slate-400">
                                    <span class="font-black text-slate-900 dark:text-white">{t.generation_label} {GENERATION_ROMAN[`gen${entry.generationId}`] ?? entry.generationId}{lang === 'es' ? ' y anteriores' : ' and earlier'}:</span>{' '}
                                    {entry.changes.map((c) => `${t[c.statName] || c.statName} ${c.baseStat}${c.effort ? ` (${c.effort} EV)` : ''}`).join(', ')}
                                </li>
                            ))}
                        </ul>
                    </div>
                )}

                {varieties && varieties.length > 0 && (
                    <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-8">{t.other_forms}</h3>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-6">
                            {varieties.map((v: any) => (
                                <a href={pagePath(lang, 'pokemon', v.name)} class="flex flex-col items-center p-6 bg-slate-50 dark:bg-slate-800/50 rounded-3xl border border-slate-100 dark:border-slate-700 hover:border-emerald-500 transition-all group no-underline">
                                    <img src={v.sprites?.other?.["official-artwork"]?.front_default || v.sprites?.front_default} alt={v.name} class="w-24 h-24 object-contain mb-3 drop-shadow-md group-hover:scale-110 transition-transform" />
                                    <span class="text-[11px] font-black text-slate-700 dark:text-slate-200 text-center capitalize tracking-tight">{v.name.replace(/-/g, ' ')}</span>
                                </a>
                            ))}
                        </div>
                    </div>
                )}
            </div>
        </div>

        {evolutionChain && <EvolutionChain chain={evolutionChain} lang={lang as string} />}
        <SmogonTier pokemonName={detail.name} lang={lang as string} tier={showdownData?.tier || null} />
        <MovesTable moves={detail.moves} lang={lang as string} availableContexts={availableContexts} defaultContext={defaultContext} />
    </div>

    <script is:inline>
        function initShiny() {
            const btn = document.getElementById('shiny-toggle');
            const img = document.getElementById('pokemon-image');
            if (!btn || !img) return;
            btn.onclick = () => {
                const isShiny = btn.classList.toggle('active');
                img.style.opacity = '0';
                setTimeout(() => { 
                    img.src = isShiny ? img.dataset.shiny : img.dataset.default; 
                    img.style.opacity = '1'; 
                }, 250);
            };
        }
        initShiny();
        document.addEventListener('astro:after-swap', initShiny);
    </script>

    <script>
    // Fase 2E: reacts to MovesTable's `pokepedia:game-context-change`
    // broadcast to filter the regional Pokédex section without a second
    // Game Context selector, a fetch, or a page navigation — same compact-
    // payload + pure-filter pattern the move page established in Fase 2D
    // for learnsets (see docs/architecture/move-learnset-relations.md and
    // this page's own note in docs/architecture/game-context.md).
    import { pokedexLabel } from '../../../services/pokedexes';
    import { regionalDexEntriesForContext, type RegionalDexEntry } from '../../../utils/pokemonFacts';
    import { readGameContext, resolveContextForPokemon } from '../../../utils/gameContextStorage';

    interface RegionalDexPayload {
        entries: [string, number][];
        contexts: { id: string; revisions: string[] }[];
        initialContext: string;
    }

    // setupRegionalDex() re-runs on every `astro:after-swap` (client-side
    // navigation via View Transitions), each time against a freshly-swapped
    // DOM. Without cleanup, each run's `document.addEventListener` call
    // would pile up: old listeners closing over DOM nodes that no longer
    // exist, firing alongside the new one on every future context change.
    // One AbortController per run, aborted before the next run creates its
    // own, keeps exactly one listener alive at any time — no global store,
    // just the same short-lived variable every other client script in this
    // codebase already keeps at module scope (e.g. MovesTable's `moveCache`).
    let regionalDexAbort: AbortController | null = null;

    function setupRegionalDex() {
        regionalDexAbort?.abort();
        regionalDexAbort = new AbortController();
        const { signal } = regionalDexAbort;

        const dataScript = document.getElementById('regional-dex-data');
        if (!dataScript) return;
        const payload: RegionalDexPayload = JSON.parse(dataScript.textContent || '{}');
        if (!payload.contexts || payload.contexts.length === 0) return;

        const langAttr = document.documentElement.lang || 'es';
        const entries: RegionalDexEntry[] = payload.entries.map(([pokedex, entryNumber]) => ({ pokedex, entryNumber }));
        const historicalCount = entries.length;

        const listEl = document.getElementById('regional-dex-list');
        const emptyEl = document.getElementById('regional-dex-empty');
        const historicalEl = document.getElementById('regional-dex-historical');
        if (!listEl) return;

        // Resolves the SAME initial state MovesTable resolves (persisted
        // context if this Pokémon has data for it, else the SSR default),
        // independently, with the exact same pure function and storage key
        // — this never depends on catching MovesTable's own broadcast for
        // correctness on load (module scripts execute in document order;
        // MovesTable's script sits earlier and dispatches synchronously, so
        // a listener registered here would already be too late for that
        // first dispatch). The event below is only relied on for a LATER,
        // live context change — always safe, since by the time a person can
        // interact with the selector both scripts have long finished
        // registering their listeners.
        let storage: Storage | null = null;
        try { storage = window.localStorage; } catch { storage = null; }
        const availableIds = payload.contexts.map((c) => c.id);
        const persisted = storage ? resolveContextForPokemon(readGameContext(storage), availableIds, payload.initialContext) : payload.initialContext;
        let currentContext = availableIds.includes(persisted) ? persisted : payload.initialContext;

        // DOM APIs, not an HTML string + innerHTML: pokedexLabel() and the
        // entry number both end up as .textContent, never parsed as markup
        // — the same escaping guarantee SSR gets from Astro automatically
        // carries over to this client-side re-render.
        function buildRow(entry: RegionalDexEntry): HTMLDivElement {
            const row = document.createElement('div');
            row.className = 'flex items-start justify-between gap-3 bg-slate-50 dark:bg-slate-800/50 rounded-xl px-4 py-3';
            const dt = document.createElement('dt');
            dt.className = 'text-slate-500 dark:text-slate-400 font-bold leading-snug';
            dt.textContent = pokedexLabel(entry.pokedex, langAttr);
            const dd = document.createElement('dd');
            dd.className = 'text-slate-900 dark:text-white font-black shrink-0 whitespace-nowrap';
            dd.textContent = `#${String(entry.entryNumber).padStart(3, '0')}`;
            row.append(dt, dd);
            return row;
        }

        function render() {
            if (!listEl) return;
            const ctx = payload.contexts.find((c) => c.id === currentContext);
            const filtered = ctx ? regionalDexEntriesForContext(entries, ctx.revisions) : entries;
            historicalEl?.classList.toggle('hidden', historicalCount <= filtered.length);

            if (filtered.length === 0) {
                listEl.classList.add('hidden');
                emptyEl?.classList.remove('hidden');
                return;
            }
            listEl.classList.remove('hidden');
            emptyEl?.classList.add('hidden');
            listEl.replaceChildren(...filtered.map(buildRow));
        }

        function onGameContextChange(e: Event) {
            const contextId = (e as CustomEvent<{ contextId: string }>).detail?.contextId;
            if (!contextId || !availableIds.includes(contextId) || contextId === currentContext) return;
            currentContext = contextId;
            render();
        }
        document.addEventListener('pokepedia:game-context-change', onGameContextChange, { signal });

        // Only re-render if hydration found a different, available persisted
        // context than the SSR default — avoids an unnecessary reflow (same
        // pattern as the move page's learnset script, Fase 2D).
        if (currentContext !== payload.initialContext) render();
    }

    setupRegionalDex();
    document.addEventListener('astro:after-swap', setupRegionalDex);
    </script>

    <script is:inline define:vars={{ _pokemonSlug: canonicalSlug, _pokemonId: pokemonId, _pokemonLabel: localizedName }}>
        // Recent-search history (same shape as utils/searchHistory.ts; legacy
        // { name, id, sprite } entries are still understood there).
        (function() {
            try {
                const raw = JSON.parse(localStorage.getItem('pokepedia_history') || '[]');
                const history = Array.isArray(raw) ? raw : [];
                const filtered = history.filter(h => h && !((h.type === 'pokemon' && h.slug === _pokemonSlug) || (h.type === undefined && h.name === _pokemonSlug)));
                filtered.unshift({ type: 'pokemon', slug: _pokemonSlug, name: _pokemonLabel, id: _pokemonId });
                localStorage.setItem('pokepedia_history', JSON.stringify(filtered.slice(0, 8)));
            } catch {}
        })();
    </script>
</Layout>
