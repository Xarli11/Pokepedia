---
import Layout from '../../../layouts/Layout.astro';
import PokemonRelationList from '../../../components/PokemonRelationList.astro';
import ReportDataIssue from '../../../components/ReportDataIssue.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getLocalizedName, getAbilityDetailByName, getPokemonCards, idFromResourceUrl, GENERATION_ROMAN } from '../../../services/pokeapi';
import { uiTranslations, formatName } from '../../../utils/pokemon';
import { pagePath, canonicalPokemonSlug } from '../../../utils/seo';
import { resolveAbilityEffect, abilityHistory } from '../../../utils/abilityFacts';
import { versionGroupLabel } from '../../../services/versionGroups';

const { lang, name } = Astro.params;

// Only this primary lookup can 404 the page (EntityNotFoundError). An
// UpstreamError or a missing related resource is answered 503 by
// src/middleware.ts; any other error surfaces as a real 500.
const abilityData = await getAbilityDetailByName((name as string).toLowerCase());

// PokeAPI resolves numeric ids and any casing (/26/, /Levitate/ -> levitate), which
// made each of those a second 200 page. Only the canonical slug renders.
if (name !== abilityData.name) {
    return Astro.redirect(pagePath(lang as string, 'habilidades', abilityData.name), 301);
}

const localizedName = getLocalizedName(abilityData.names, lang as string) || formatName(abilityData.name);

// Mechanical effect vs. in-game flavor text, distinguished explicitly (see
// utils/abilityFacts.ts) — never presented as if flavor were an exhaustive
// mechanical explanation.
const description = resolveAbilityEffect(lang as string, abilityData.effect_entries, abilityData.flavor_text_entries);
const history = abilityHistory(lang as string, abilityData.effect_changes);

const abilityGenNumRaw = abilityData.generation?.url ? idFromResourceUrl(abilityData.generation.url) : null;
const abilityGenKey = abilityGenNumRaw ? `gen${abilityGenNumRaw}` : null;
const abilityGenRoman = abilityGenKey ? GENERATION_ROMAN[abilityGenKey] : null;

// The list is capped for page weight; the counter reports the real total
// (abilityData.pokemon), not the number of cards rendered — this used to
// show the capped count as if it were the total.
const POKEMON_LIST_LIMIT = 60;
const totalWithAbility = abilityData.pokemon.length;
const isHiddenByName = new Map(abilityData.pokemon.map((p) => [p.pokemon.name, p.is_hidden]));
const pokemonList = await getPokemonCards(abilityData.pokemon.map(p => p.pokemon), POKEMON_LIST_LIMIT);
const t = uiTranslations[lang as string] || uiTranslations.es;

const breadcrumbItems = [
    { label: t.breadcrumb_home, href: pagePath(lang as string) },
    { label: t.abilities, href: pagePath(lang as string, 'habilidades') },
    { label: localizedName },
];
---

<Layout
    title={`${localizedName} | ${t.abilities}`}
    description={description?.text ?? ''}
    lang={lang}
>
    <div class="max-w-5xl mx-auto">
        <Breadcrumbs items={breadcrumbItems} />
        <a href={pagePath(lang as string, 'habilidades')} class="inline-flex items-center gap-2 text-slate-500 dark:text-slate-400 hover:text-emerald-500 dark:hover:text-emerald-400 font-medium transition-colors mb-8 group">
            <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            {t.back_to_abilities}
        </a>

        <div class="bg-white dark:bg-slate-800 rounded-[3rem] p-10 md:p-16 border border-slate-100 dark:border-slate-700 shadow-2xl shadow-slate-200/50 dark:shadow-black/40 mb-16 transition-colors">
            <div class="flex items-center gap-4 mb-3 flex-wrap">
                <span class="w-3 h-12 bg-emerald-500 rounded-full"></span>
                <h1 class="text-5xl md:text-6xl font-black text-slate-900 dark:text-white capitalize tracking-tighter">{localizedName}</h1>
                {abilityGenRoman && abilityGenKey && (
                    <a href={pagePath(lang as string, 'generacion', String(abilityGenNumRaw))} class="px-4 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-[0.2em] bg-slate-100 dark:bg-slate-900 text-slate-500 dark:text-slate-400 hover:bg-emerald-500 hover:text-white transition-all no-underline">
                        {t.generation_label} {abilityGenRoman}
                    </a>
                )}
                {!abilityData.is_main_series && (
                    <span class="px-4 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-[0.2em] bg-slate-100 dark:bg-slate-900 text-slate-400 dark:text-slate-500">{t.ability_not_main_series}</span>
                )}
            </div>
            <div class="mb-8 pl-7"><ReportDataIssue entityType="ability" entitySlug={abilityData.name} lang={lang as string} /></div>
            <div class="bg-emerald-50/50 dark:bg-emerald-950/10 rounded-[2rem] p-8 md:p-10 border border-emerald-100/50 dark:border-emerald-900/20">
                <p class="text-[10px] font-black text-emerald-600 dark:text-emerald-400 uppercase tracking-widest mb-3">{description?.source === 'effect' ? t.ability_effect : t.ability_flavor_note}</p>
                {description && (
                    <p class="text-xl md:text-2xl text-slate-700 dark:text-slate-300 leading-relaxed italic font-medium">
                        "{description.text}"
                    </p>
                )}
            </div>
        </div>

        {history.length > 0 && (
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-10 border border-slate-100 dark:border-slate-800 shadow-sm mb-16">
                <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">{t.ability_history}</h2>
                <ul class="space-y-3 text-sm list-none p-0 m-0">
                    {history.map((h) => (
                        <li class="text-slate-600 dark:text-slate-400">
                            <span class="font-black text-slate-900 dark:text-white">{versionGroupLabel(h.versionGroup, lang as string)}{lang === 'es' ? ' y anteriores' : ' and earlier'}:</span> "{h.effect}"
                        </li>
                    ))}
                </ul>
            </div>
        )}

        <h2 class="text-3xl font-black text-slate-900 dark:text-white mb-10 px-4 flex items-center gap-4">
            <span class="w-2 h-8 bg-emerald-500/50 rounded-full"></span>
            {t.pokemon_with_ability}
            <span class="text-sm font-bold text-slate-400 dark:text-slate-600 bg-slate-100 dark:bg-slate-800/50 px-4 py-1.5 rounded-full border border-slate-200/50 dark:border-slate-700">{totalWithAbility}</span>
            {totalWithAbility > pokemonList.length && (
                <span class="text-xs font-bold text-slate-400 dark:text-slate-600">{lang === 'es' ? `Mostrando ${pokemonList.length}` : `Showing ${pokemonList.length}`}</span>
            )}
        </h2>

        <PokemonRelationList
            entries={pokemonList.map((pokemon) => ({
                pokemon: { id: pokemon.id, slug: canonicalPokemonSlug(pokemon), name: pokemon.name },
                detail: isHiddenByName.get(pokemon.name) ? t.hidden_ability_tag : undefined,
            }))}
            lang={lang as string}
        />
    </div>
</Layout>
