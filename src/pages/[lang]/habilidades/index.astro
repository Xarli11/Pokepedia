---
import Layout from '../../../layouts/Layout.astro';
import { getAllAbilities } from '../../../services/pokeapi';
import { getAbilityCatalog } from '../../../services/catalogs';
import { uiTranslations, formatName } from '../../../utils/pokemon';
import { pagePath } from '../../../utils/seo';

const { lang = 'es' } = Astro.params;
// Limitamos a 307 que son las habilidades oficiales hasta Gen 9 (evitando CAP y entries de debug)
const abilities = await getAllAbilities();
// Name and one-line description per ability come from the generated catalog
// (scripts/generate-catalogs.ts), server-rendered: no per-card request.
const catalog = await getAbilityCatalog(lang as string);
const t = uiTranslations[lang as string] || uiTranslations.es;
---

<Layout title={t.abilities_title_seo} lang={lang}>
    <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
            <h1 class="text-5xl md:text-6xl font-black text-slate-900 dark:text-white mb-4 tracking-tight">
                {t.abilities}
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-lg font-medium italic">
                {t.abilities_desc_seo}
            </p>
        </div>

        <div class="relative max-w-2xl mx-auto mb-16 group">
            <div class="absolute inset-y-0 left-0 pl-6 flex items-center pointer-events-none">
                <svg class="w-6 h-6 text-slate-400 group-focus-within:text-emerald-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <input 
                type="text" 
                id="ability-search" 
                placeholder={t.search_ability} 
                class="w-full pl-16 pr-8 py-6 rounded-[2.5rem] bg-white dark:bg-slate-800 border-2 border-slate-100 dark:border-slate-700 text-slate-900 dark:text-white text-xl shadow-2xl shadow-slate-200/50 dark:shadow-black/40 focus:border-emerald-500 outline-none transition-all"
                autocomplete="off"
            />
            <!-- Contenedor de Sugerencias -->
            <div id="search-suggestions" class="absolute top-full left-0 right-0 mt-2 bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-slate-100 dark:border-slate-700 z-50 hidden overflow-hidden max-h-[400px] overflow-y-auto">
            </div>
        </div>

        <div id="ability-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {abilities.map((ability) => {
                const info = catalog.get(ability.name);
                return (
                    <a href={pagePath(lang, 'habilidades', ability.name)} class="ability-card group" data-name={ability.name}>
                        <div class="ab-head">
                            <h3 class="ab-title">{info?.name || formatName(ability.name)}</h3>
                            <div class="ab-arrow">
                                <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </div>
                        </div>
                        {info?.description && <p class="ab-desc">{info.description}</p>}
                    </a>
                );
            })}
        </div>
    </div>

    <!-- Card styling in one stylesheet, not repeated on each card. Same utilities, same look. -->
    <style is:global>
        @reference "../../../styles/global.css";
        .ability-card { @apply block bg-white dark:bg-slate-800 p-8 rounded-[2.5rem] border border-slate-100 dark:border-slate-700 shadow-sm hover:border-emerald-200 dark:hover:border-emerald-800 hover:shadow-2xl hover:shadow-emerald-100/20 dark:hover:shadow-emerald-950/20 transition-all; }
        .ab-head { @apply flex justify-between items-start mb-6; }
        .ab-title { @apply text-2xl font-black text-slate-800 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors; }
        .ab-arrow { @apply p-3 bg-emerald-50 dark:bg-emerald-900/20 rounded-2xl text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-all transform translate-x-2 group-hover:translate-x-0; }
        .ab-desc { @apply text-sm text-slate-500 dark:text-slate-400 leading-relaxed font-medium; }
    </style>

    <div id="habilidades-data" data-lang={lang} class="hidden"></div>

    <script>
        import { applyCatalogFilter, readRows, showSuggestions } from '../../../utils/catalogSearch';

        // Everything the filter needs is in the server-rendered cards: nothing is fetched.
        function init() {
            const dataEl = document.getElementById('habilidades-data');
            if (!dataEl) return;
            const input = document.querySelector<HTMLInputElement>('#ability-search');
            const suggestions = document.getElementById('search-suggestions');
            if (!input || !suggestions) return;

            const rows = readRows(
                document.querySelectorAll<HTMLElement>('.ability-card'),
                (el) => el.querySelector('.ab-title')?.textContent ?? '',
                (el) => el.querySelector('.ab-desc')?.textContent ?? ''
            );
            const options = { input, suggestions, rows };

            input.addEventListener('input', () => {
                applyCatalogFilter(options);
                showSuggestions(options);
            });

            document.addEventListener('click', (e) => {
                if (!(e.target instanceof Node)) return;
                if (!input.contains(e.target) && !suggestions.contains(e.target)) suggestions.classList.add('hidden');
            });
        }

        document.addEventListener('astro:page-load', init);
    </script>
</Layout>
