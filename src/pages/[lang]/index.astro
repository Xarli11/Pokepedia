---
import Layout from '../../layouts/Layout.astro';
import { getPokemonByGeneration, GENERATIONS } from '../../services/pokeapi';
import { getSmogonDataBatch } from '../../services/smogon';
import { uiTranslations, typeTranslations, typeColors } from '../../utils/pokemon';

const { lang = 'es' } = Astro.params;
const url = new URL(Astro.request.url);
const gen = url.searchParams.get('gen') || 'gen1';

const pokemonList = await getPokemonByGeneration(gen);

// B1: enrich with Smogon types + stats in SSR to avoid N client fetches
const smogonBatch = pokemonList.length > 0 ? await getSmogonDataBatch(pokemonList.map(p => p.name)) : {};
const enrichedList = pokemonList.map(p => {
    const sd = smogonBatch[p.name];
    return {
        ...p,
        types: sd?.types || [],
        stats: sd?.baseStats || {}
    };
});

const t = uiTranslations[lang as string] || uiTranslations.es;
---

<Layout lang={lang}>
    <div class="text-center mb-20 max-w-4xl mx-auto mt-12 px-4">
        <h1 class="text-6xl md:text-8xl font-black text-slate-900 dark:text-white mb-8 tracking-tighter">
            {t.desc_hero} <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-teal-400">Pokémon</span>
        </h1>
        <p class="text-xl md:text-2xl text-slate-500 dark:text-slate-400 leading-relaxed font-medium max-w-2xl mx-auto">
            {t.desc_subtitle}
        </p>
    </div>

    <!-- Buscador Global Gris Azulado -->
    <div class="max-w-2xl mx-auto mb-20 relative">
        <div class="relative z-40 group">
            <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-slate-400 group-focus-within:text-emerald-500 transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <input 
                type="text" 
                id="global-search"
                placeholder={t.search_placeholder} 
                autocomplete="off"
                class="w-full pl-14 pr-6 py-5 rounded-[2rem] bg-white dark:bg-slate-800 border-2 border-slate-100 dark:border-slate-700 text-slate-900 dark:text-white text-lg placeholder-slate-400 focus:outline-none focus:border-emerald-500/50 dark:focus:border-emerald-500/30 shadow-2xl shadow-slate-200/50 dark:shadow-black/40 transition-all duration-300"
            >
        </div>

        <!-- Resultados Autocomplete -->
        <div id="search-suggestions" class="hidden absolute top-full left-0 right-0 mt-4 bg-white/95 dark:bg-slate-800/95 rounded-[2rem] border border-slate-100 dark:border-slate-700 shadow-2xl overflow-hidden z-[100] max-h-[450px] overflow-y-auto backdrop-blur-xl transition-all">
            <div id="suggestions-list" class="divide-y divide-slate-50 dark:divide-slate-700/50">
                <!-- JS -->
            </div>
        </div>

        <!-- Filtros Avanzados -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <select 
                id="type-filter"
                class="px-6 py-3 rounded-2xl bg-white dark:bg-slate-800 border-2 border-slate-100 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-bold text-xs uppercase tracking-widest focus:outline-none focus:border-emerald-500/50 transition-all cursor-pointer appearance-none shadow-sm"
            >
                <option value="all">{t.all_types}</option>
                {Object.keys(typeTranslations[lang as string]).map(type => (
                    <option value={type}>{typeTranslations[lang as string][type]}</option>
                ))}
            </select>

            <select 
                id="sort-order"
                class="px-6 py-3 rounded-2xl bg-white dark:bg-slate-800 border-2 border-slate-100 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-bold text-xs uppercase tracking-widest focus:outline-none focus:border-emerald-500/50 transition-all cursor-pointer appearance-none shadow-sm"
            >
                <option value="id-asc">{lang === 'es' ? 'Nº Pokédex (Menor a Mayor)' : 'Pokédex No. (Low to High)'}</option>
                <option value="id-desc">{lang === 'es' ? 'Nº Pokédex (Mayor a Menor)' : 'Pokédex No. (High to Low)'}</option>
                <option value="name-asc">{lang === 'es' ? 'Nombre (A-Z)' : 'Name (A-Z)'}</option>
                <option value="name-desc">{lang === 'es' ? 'Nombre (Z-A)' : 'Name (Z-A)'}</option>
                <option value="hp-desc">{t.stat_hp || 'HP'} ↓</option>
                <option value="atk-desc">{t.stat_atk || 'ATK'} ↓</option>
                <option value="def-desc">{t.stat_def || 'DEF'} ↓</option>
                <option value="spa-desc">{t.stat_spatk || 'SP.ATK'} ↓</option>
                <option value="spd-desc">{t.stat_spdef || 'SP.DEF'} ↓</option>
                <option value="spe-desc">{t.stat_spd || 'SPD'} ↓</option>
                <option value="total-desc">{t.total || 'Total'} ↓</option>
            </select>
            
            <a href={`/${lang}/comparar/charizard/venusaur`} class="inline-flex items-center gap-3 px-6 py-3 rounded-2xl bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 font-black uppercase tracking-widest text-[10px] hover:bg-emerald-500 hover:text-white transition-all group no-underline">
                <svg class="w-4 h-4 group-hover:rotate-12 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path d="M16 3l4 4-4 4M8 21l-4-4 4-4M20 7H4M4 17h16" />
                </svg>
                {t.compare}
            </a>
        </div>
        
        <!-- Selector de Regiones: Lab Terminal Switcher -->
        {gen !== 'favorites' && (
            <div class="mt-12 mb-16 max-w-5xl mx-auto px-4">
                <div class="bg-slate-200/30 dark:bg-slate-900/40 backdrop-blur-md rounded-[2rem] p-1.5 border border-slate-200/50 dark:border-slate-800/50 shadow-inner">
                    <div class="overflow-x-auto no-scrollbar snap-x snap-mandatory flex gap-1 items-center">
                        {Object.entries(GENERATIONS).map(([key, value], index) => (
                            <button 
                                class={`gen-pill snap-center flex-1 min-w-[110px] sm:min-w-0 px-4 py-3 rounded-[1.5rem] transition-all duration-500 flex flex-col items-center gap-0.5 group/pill ${
                                    gen === key 
                                    ? 'bg-white dark:bg-emerald-500 shadow-lg dark:shadow-emerald-500/20 z-10' 
                                    : 'hover:bg-white/50 dark:hover:bg-slate-800/50'
                                }`}
                                data-gen={key}
                            >
                                <span class={`text-[8px] font-mono font-bold tracking-[0.2em] ${
                                    gen === key ? 'text-emerald-500 dark:text-emerald-100' : 'text-slate-400 dark:text-slate-600'
                                }`}>
                                    0{index + 1}
                                </span>
                                <span class={`text-[10px] font-black uppercase tracking-wider ${
                                    gen === key ? 'text-slate-900 dark:text-white' : 'text-slate-500 dark:text-slate-500'
                                }`}>
                                    {value.region}
                                </span>
                            </button>
                        ))}
                    </div>
                </div>
                
                <!-- Indicador de Scroll para Móvil -->
                <div class="flex justify-center gap-1 mt-4 sm:hidden opacity-30">
                    {Object.keys(GENERATIONS).map((key) => (
                        <div class={`h-1 w-1 rounded-full transition-all ${gen === key ? 'w-4 bg-emerald-500 opacity-100' : 'bg-slate-400'}`}></div>
                    ))}
                </div>
            </div>
        )}

        {gen === 'favorites' && (
            <div class="mt-8 mb-16 text-center">
                <div class="inline-flex items-center gap-3 px-6 py-2 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-rose-500 font-black uppercase tracking-[0.2em] text-xs">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"></path>
                    </svg>
                    {t.favorites}
                </div>
            </div>
        )}
    </div>

    <!-- Grid -->
    <div id="no-results" class="hidden text-center py-20">
        <div class="inline-flex items-center justify-center w-24 h-24 bg-slate-100 dark:bg-slate-800 rounded-full mb-6">
            <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 9.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="text-2xl font-bold text-slate-800 dark:text-white mb-2">{lang === 'es' ? 'No se encontraron Pokémon' : 'No Pokémon found'}</h3>
        <p class="text-slate-500 dark:text-slate-400">{lang === 'es' ? 'Intenta buscar en las sugerencias o cambiar de región.' : 'Try searching in suggestions or change region.'}</p>
    </div>

    <div id="pokemon-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {enrichedList.map((p) => (
            <div
                class="group relative bg-white dark:bg-slate-900/80 rounded-[3rem] p-8 pb-12 border border-slate-200/50 dark:border-slate-800/50 hover:bg-white/80 dark:hover:bg-slate-800/40 hover:backdrop-blur-xl hover:border-emerald-500/50 dark:hover:border-emerald-500/30 hover:shadow-2xl hover:shadow-emerald-500/10 transition-all duration-500 flex flex-col items-center overflow-hidden pokemon-card"
                data-name={p.name}
                data-id={p.id}
                data-types={p.types.join(',')}
                data-hp={p.stats.hp ?? ''}
                data-atk={p.stats.atk ?? ''}
                data-def={p.stats.def ?? ''}
                data-spa={p.stats.spa ?? ''}
                data-spd={p.stats.spd ?? ''}
                data-spe={p.stats.spe ?? ''}
                data-total={p.types.length > 0 ? Object.values(p.stats).reduce((a: number, b: any) => a + (b || 0), 0) : ''}
            >
                {/* Enlace invisible que cubre toda la card */}
                <a href={`/${lang}/pokemon/${p.name}`} class="absolute inset-0 z-10 rounded-[3rem]" aria-label={p.name.replace(/-/g, ' ')}></a>
                {/* Top accent bar con color del tipo primario */}
                {p.types.length > 0 && (
                    <div class="absolute top-0 left-0 right-0 h-0.5 opacity-60 pointer-events-none" style={`background-color: ${(typeColors as Record<string,string>)[p.types[0]] || '#10b981'}`} aria-hidden="true"></div>
                )}

                {/* Fav button — único elemento interactivo, z-20 por encima del link */}
                <div class="relative z-20 w-full flex items-center justify-between mb-10 pointer-events-none">
                    <span class="text-slate-300 dark:text-slate-600 font-black text-xs tracking-[0.2em]">#{p.id.toString().padStart(4, '0')}</span>
                    <button
                        class="fav-btn pointer-events-auto p-3 rounded-full bg-slate-50 dark:bg-slate-950/40 border border-slate-100/50 dark:border-slate-800/50 hover:bg-rose-500/10 transition-all duration-300 group/fav-btn text-rose-500"
                        data-pokemon={p.name}
                        onclick="event.preventDefault(); window.toggleFavorite(this.dataset.pokemon);"
                        aria-label={`${lang === 'es' ? 'Favorito' : 'Favorite'} ${p.name.replace(/-/g, ' ')}`}
                    >
                        <svg class="w-6 h-6 heart-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"></path></svg>
                    </button>
                </div>
                {/* Sprite + glow — pointer-events-none para que el click pase al <a> */}
                <div class="pointer-events-none relative z-10 w-56 h-56 flex items-center justify-center transition-all duration-700 group-hover:scale-110 group-hover:-rotate-3">
                    <img src={p.sprite} alt={p.name.replace(/-/g, ' ')} width="220" height="220" class="w-full h-full object-contain drop-shadow-2xl" loading="lazy" onerror="this.src='/pokeball.png'; this.classList.add('opacity-20');">
                    <div class="absolute inset-0 blur-[60px] rounded-full opacity-0 group-hover:opacity-50 transition-opacity duration-700" style={p.types.length > 0 ? `background-color: ${(typeColors as Record<string,string>)[p.types[0]] || '#10b981'}` : 'background-color: #10b981'} aria-hidden="true"></div>
                </div>
                <p class="pointer-events-none relative z-10 mt-10 text-3xl font-[1000] text-slate-800 dark:text-white capitalize group-hover:text-emerald-500 transition-colors tracking-tighter text-center">{p.name.replace(/-/g, ' ')}</p>
                <div class="pointer-events-none relative z-10 flex flex-wrap justify-center gap-3 mt-6">
                    {p.types.length > 0 ? p.types.map(typeName => (
                        <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/50 dark:bg-slate-900/40 border border-slate-100/50 dark:border-slate-700/50 shadow-sm shrink-0">
                            <div class="w-2 h-2 rounded-full" style={`background-color: ${(typeColors as any)[typeName] || '#777'};`} aria-hidden="true"></div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-600 dark:text-slate-400">{typeTranslations[lang as string]?.[typeName] || typeName}</span>
                        </div>
                    )) : (
                        <div class="h-8 w-20 bg-slate-100 dark:bg-slate-800 animate-pulse rounded-xl"></div>
                    )}
                </div>
            </div>
        ))}
    </div>

    <div id="index-data" data-lang={lang} data-gen={gen} data-translations={JSON.stringify(uiTranslations)} class="hidden"></div>

    <script>
        import { trackEvent } from '../../utils/analytics';
        import { fetchPokeApiJson, POKEAPI_BASE } from '../../utils/pokeapiClient';

        const typeColorsClient: Record<string, string> = {
            normal: '#A8A77A', fire: '#EE8130', water: '#6390F0', electric: '#F7D02C', grass: '#7AC74C',
            ice: '#96D9D6', fighting: '#C22E28', poison: '#A33EA1', ground: '#E2BF65', flying: '#A98FF3',
            psychic: '#F95587', bug: '#A6B91A', rock: '#B6A136', ghost: '#735797', dragon: '#6F35FC',
            dark: '#705746', steel: '#B7B7CE', fairy: '#D685AD'
        };

        let searchTimeout: ReturnType<typeof setTimeout>;

        function normalize(str: string) {
            return str.toLowerCase().replace(/-/g, ' ').trim();
        }

        function escHtml(str: string) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function applyFilters() {
            const searchInput = document.getElementById('global-search') as HTMLInputElement;
            const typeFilter = document.getElementById('type-filter') as HTMLSelectElement;
            const sortOrder = document.getElementById('sort-order') as HTMLSelectElement;
            const grid = document.getElementById('pokemon-grid');
            const noResults = document.getElementById('no-results');

            if (!searchInput || !typeFilter || !sortOrder || !grid) return;

            const query = normalize(searchInput.value);
            const selectedType = typeFilter.value;
            const currentSort = sortOrder.value;
            const currentCards = Array.from(document.querySelectorAll<HTMLElement>('.pokemon-card'));

            let visibleCount = 0;
            currentCards.forEach(card => {
                const name = normalize(card.getAttribute('data-name') || '');
                const id = card.getAttribute('data-id') || '';
                const types = (card.getAttribute('data-types') || '').split(',');

                const matchesSearch = query === '' || name.includes(query) || id.includes(query);
                const matchesType = selectedType === 'all' || types.includes(selectedType);

                const isVisible = matchesSearch && matchesType;
                card.style.display = isVisible ? 'flex' : 'none';
                if (isVisible) visibleCount++;
            });

            const sortedCards = currentCards.sort((a, b) => {
                const getStat = (card: HTMLElement, stat: string) => parseInt(card.dataset[stat] || '0');
                if (currentSort === 'id-asc') return parseInt(a.dataset.id || '0') - parseInt(b.dataset.id || '0');
                if (currentSort === 'id-desc') return parseInt(b.dataset.id || '0') - parseInt(a.dataset.id || '0');
                if (currentSort === 'name-asc') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
                if (currentSort === 'name-desc') return (b.dataset.name || '').localeCompare(a.dataset.name || '');
                const statMap: Record<string, string> = {
                    'hp-desc': 'hp', 'atk-desc': 'atk', 'def-desc': 'def',
                    'spa-desc': 'spa', 'spd-desc': 'spd', 'spe-desc': 'spe', 'total-desc': 'total'
                };
                if (statMap[currentSort]) return getStat(b, statMap[currentSort]) - getStat(a, statMap[currentSort]);
                return 0;
            });
            sortedCards.forEach(card => grid.appendChild(card));

            if (visibleCount === 0 && (query.length > 0 || selectedType !== 'all')) {
                grid.classList.add('hidden');
                noResults?.classList.remove('hidden');
            } else {
                grid.classList.remove('hidden');
                noResults?.classList.add('hidden');
            }
        }

        function createPokemonCard(p: any, lang: string) {
            const card = document.createElement('div');
            card.className = "group relative bg-white dark:bg-slate-900/80 rounded-[3rem] p-8 pb-12 border border-slate-200/50 dark:border-slate-800/50 hover:bg-white/80 dark:hover:bg-slate-800/40 hover:backdrop-blur-xl hover:border-emerald-500/50 dark:hover:border-emerald-500/30 hover:shadow-2xl hover:shadow-emerald-500/10 transition-all duration-500 flex flex-col items-center overflow-hidden pokemon-card";
            card.dataset.name = p.name;
            card.dataset.id = String(p.id);
            const types: string[] = p.types.map((t: any) => t.type.name);
            card.dataset.types = types.join(',');

            const stats: Record<string, number> = {
                hp: p.stats.find((s: any) => s.stat.name === 'hp')?.base_stat || 0,
                atk: p.stats.find((s: any) => s.stat.name === 'attack')?.base_stat || 0,
                def: p.stats.find((s: any) => s.stat.name === 'defense')?.base_stat || 0,
                spa: p.stats.find((s: any) => s.stat.name === 'special-attack')?.base_stat || 0,
                spd: p.stats.find((s: any) => s.stat.name === 'special-defense')?.base_stat || 0,
                spe: p.stats.find((s: any) => s.stat.name === 'speed')?.base_stat || 0,
            };
            stats.total = Object.values(stats).reduce((a, b) => a + b, 0);
            Object.entries(stats).forEach(([k, v]) => { card.dataset[k] = String(v); });

            const typesHtml = types.map(typeName => `
                <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-white/50 dark:bg-slate-900/40 border border-slate-100/50 dark:border-slate-700/50 shadow-sm shrink-0">
                    <div class="w-2 h-2 rounded-full" style="background-color: ${typeColorsClient[typeName] || '#777'};" aria-hidden="true"></div>
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-600 dark:text-slate-400">${escHtml(typeName)}</span>
                </div>
            `).join('');

            const spriteUrl = p.sprites?.other?.['official-artwork']?.front_default || p.sprites?.front_default || '/pokeball.png';
            const safeName = escHtml(p.name);
            const safeDisplayName = escHtml(p.name.replace(/-/g, ' '));

            const accentColor = typeColorsClient[types[0]] || '#10b981';
            // Link covers entire card; fav button sits above it via z-index
            card.innerHTML = `
                <a href="/${lang}/pokemon/${safeName}" class="absolute inset-0 z-10 rounded-[3rem]" aria-label="${safeDisplayName}"></a>
                <div class="absolute top-0 left-0 right-0 h-0.5 opacity-60 pointer-events-none" style="background-color: ${accentColor}" aria-hidden="true"></div>
                <div class="relative z-20 w-full flex items-center justify-between mb-10 pointer-events-none">
                    <span class="text-slate-300 dark:text-slate-600 font-black text-xs tracking-[0.2em]">#${String(p.id).padStart(4, '0')}</span>
                    <button class="fav-btn pointer-events-auto p-3 rounded-full bg-slate-50 dark:bg-slate-950/40 border border-slate-100/50 dark:border-slate-800/50 hover:bg-rose-500/10 transition-all duration-300 group/fav-btn text-rose-500" data-pokemon="${safeName}" aria-label="Favorite ${safeDisplayName}">
                        <svg class="w-6 h-6 heart-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"></path></svg>
                    </button>
                </div>
                <div class="pointer-events-none relative w-56 h-56 flex items-center justify-center transition-all duration-700 group-hover:scale-110 group-hover:-rotate-3">
                    <img src="${spriteUrl}" alt="${safeDisplayName}" width="220" height="220" class="w-full h-full object-contain drop-shadow-2xl" loading="lazy" onerror="this.src='/pokeball.png'; this.classList.add('opacity-20');">
                    <div class="absolute inset-0 blur-[60px] rounded-full opacity-0 group-hover:opacity-50 transition-opacity duration-700" style="background-color: ${typeColorsClient[types[0]] || '#10b981'}" aria-hidden="true"></div>
                </div>
                <p class="pointer-events-none mt-10 text-3xl font-[1000] text-slate-800 dark:text-white capitalize group-hover:text-emerald-500 transition-colors tracking-tighter text-center">${safeDisplayName}</p>
                <div class="pointer-events-none flex flex-wrap justify-center gap-3 mt-6 px-4">${typesHtml}</div>
            `;

            const favBtn = card.querySelector('.fav-btn') as HTMLButtonElement;
            if (favBtn) favBtn.onclick = () => (window as any).toggleFavorite(p.name);
            return card;
        }

        async function loadFavoritesView(lang: string, t: Record<string, string>) {
            const grid = document.getElementById('pokemon-grid');
            const noResults = document.getElementById('no-results');
            const favorites = JSON.parse(localStorage.getItem('pokepedia_favorites') || '[]');

            if (!grid) return;
            grid.innerHTML = '';

            if (favorites.length === 0) {
                noResults?.classList.remove('hidden');
                const h3 = noResults?.querySelector('h3');
                const p = noResults?.querySelector('p');
                if (h3) h3.textContent = t.no_favorites || 'No favorites';
                if (p) p.textContent = '';
                return;
            }

            noResults?.classList.add('hidden');
            grid.classList.remove('hidden');

            grid.innerHTML = Array(6).fill(0).map(() =>
                `<div class="h-[500px] bg-white dark:bg-slate-900/50 rounded-[3rem] animate-pulse border border-slate-100 dark:border-slate-800"></div>`
            ).join('');

            // A8: use allSettled so a single failing fetch doesn't kill the whole list
            const results = await Promise.allSettled(
                favorites.map((name: string) => fetchPokeApiJson(`${POKEAPI_BASE}/pokemon/${name}`, 6000))
            );

            grid.innerHTML = '';
            results.forEach(result => {
                if (result.status === 'fulfilled' && result.value) {
                    grid.appendChild(createPokemonCard(result.value, lang));
                }
            });

            applyFilters();
            if ((window as any).updateTiers) (window as any).updateTiers();
        }

        function init() {
            const dataEl = document.getElementById('index-data');
            if (!dataEl) return;
            const lang = dataEl.dataset.lang || 'es';
            const gen = dataEl.dataset.gen;
            const uiTranslations = JSON.parse(dataEl.dataset.translations || '{}');
            const t = uiTranslations[lang] || uiTranslations.es;

            // SSR cards already have types/stats from Smogon batch — just apply filters
            applyFilters();
            if (gen === 'favorites') {
                loadFavoritesView(lang, t);
            }

            const searchInput = document.getElementById('global-search') as HTMLInputElement | null;
            const typeFilter = document.getElementById('type-filter');
            const sortOrder = document.getElementById('sort-order');
            const suggestionsContainer = document.getElementById('search-suggestions');
            const suggestionsList = document.getElementById('suggestions-list');
            const genPills = document.querySelectorAll<HTMLElement>('.gen-pill');

            async function handleSearch() {
                if (!searchInput || !suggestionsContainer || !suggestionsList) return;

                const query = normalize(searchInput.value);
                applyFilters();
                
                clearTimeout(searchTimeout);
                if (query.length >= 2) {
                    searchTimeout = setTimeout(async () => {
                        suggestionsContainer.classList.remove('hidden');
                        suggestionsList.innerHTML = Array(3).fill(0).map(() => `
                            <div class="flex items-center gap-5 px-6 py-4 animate-pulse">
                                <div class="w-12 h-12 bg-slate-100 dark:bg-slate-700 rounded-2xl"></div>
                                <div class="flex flex-col gap-2">
                                    <div class="w-10 h-2 bg-slate-100 dark:bg-slate-700 rounded"></div>
                                    <div class="w-24 h-4 bg-slate-100 dark:bg-slate-700 rounded"></div>
                                </div>
                            </div>
                        `).join('');

                        try {
                            const res = await fetch(`/api/suggestions?q=${encodeURIComponent(query)}`);
                            const matches = await res.json();
                            trackEvent('global_search', { language: lang, target: matches.length > 0 ? 'results' : 'no_results', source_surface: 'home_search' });

                            if (matches.length > 0) {
                                // A1: build suggestion items with DOM (no innerHTML with API data)
                                suggestionsList.innerHTML = '';
                                matches.forEach((p: any) => {
                                    const spriteUrl = p.sprite || `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${p.id}.png`;
                                    const isVariety = p.id > 10000;
                                    const a = document.createElement('a');
                                    a.href = `/${lang}/pokemon/${escHtml(p.name)}`;
                                    a.className = 'flex items-center gap-5 px-6 py-4 hover:bg-emerald-50 dark:hover:bg-emerald-950/20 transition-colors group';
                                    const img = document.createElement('img');
                                    img.src = spriteUrl;
                                    img.alt = p.name;
                                    img.className = 'w-10 h-10 object-contain image-render-pixel';
                                    img.loading = 'lazy';
                                    img.onerror = function() { (this as HTMLImageElement).src = '/pokeball.png'; (this as HTMLImageElement).classList.add('opacity-20'); };
                                    const imgWrap = document.createElement('div');
                                    imgWrap.className = 'w-12 h-12 bg-slate-50 dark:bg-slate-900/50 rounded-2xl flex items-center justify-center p-1 border border-slate-100 dark:border-slate-700/50 group-hover:bg-white dark:group-hover:bg-slate-800 transition-colors shadow-sm';
                                    imgWrap.appendChild(img);
                                    const textWrap = document.createElement('div');
                                    textWrap.className = 'flex flex-col';
                                    const idSpan = document.createElement('span');
                                    idSpan.className = 'text-[10px] font-black text-slate-300 dark:text-slate-600';
                                    idSpan.textContent = isVariety ? (t.special_form || 'SPECIAL') : '#' + String(p.id).padStart(4, '0');
                                    const nameSpan = document.createElement('span');
                                    nameSpan.className = 'text-slate-700 dark:text-slate-200 font-bold capitalize group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors';
                                    nameSpan.textContent = p.name.replace(/-/g, ' ');
                                    textWrap.appendChild(idSpan);
                                    textWrap.appendChild(nameSpan);
                                    const arrow = document.createElement('span');
                                    arrow.className = 'ml-auto text-[9px] font-black text-slate-400 dark:text-slate-600 uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-all transform translate-x-2 group-hover:translate-x-0';
                                    arrow.textContent = lang === 'es' ? 'Ver Ficha →' : 'View Info →';
                                    a.appendChild(imgWrap);
                                    a.appendChild(textWrap);
                                    a.appendChild(arrow);
                                    suggestionsList.appendChild(a);
                                });
                            } else {
                                suggestionsContainer.classList.add('hidden');
                            }
                        } catch (e) {
                            console.error('Error fetching suggestions:', e);
                            suggestionsContainer.classList.add('hidden');
                        }
                    }, 300);
                } else {
                    suggestionsContainer.classList.add('hidden');
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', handleSearch);
                searchInput.addEventListener('focus', () => {
                    if (normalize(searchInput.value).length >= 2) {
                        suggestionsContainer?.classList.remove('hidden');
                    }
                });
                searchInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        const suggestionsList = document.getElementById('suggestions-list');
                        const firstResult = suggestionsList?.querySelector('a');
                        if (firstResult) {
                            window.location.href = firstResult.href;
                        }
                    }
                });
            }

            if (typeFilter) typeFilter.addEventListener('change', () => applyFilters());
            if (sortOrder) sortOrder.addEventListener('change', () => applyFilters());

            // Use AbortController so these listeners are cleaned up on next page-load
            const ac = new AbortController();
            const { signal } = ac;
            (window as any)._indexAbortController?.abort();
            (window as any)._indexAbortController = ac;

            document.addEventListener('keydown', (e) => {
                if (e.key === '/' && document.activeElement?.id !== 'global-search') {
                    const si = document.getElementById('global-search') as HTMLInputElement;
                    if (si) { e.preventDefault(); si.focus(); window.scrollTo({ top: (si as HTMLElement).offsetTop - 100, behavior: 'smooth' }); }
                }
            }, { signal });

            document.addEventListener('click', (e) => {
                if (searchInput && suggestionsContainer && !searchInput.contains(e.target as Node) && !suggestionsContainer.contains(e.target as Node)) {
                    suggestionsContainer.classList.add('hidden');
                }
            }, { signal });

            genPills.forEach(pill => {
                pill.onclick = () => {
                    const url = new URL(window.location.href);
                    url.searchParams.set('gen', pill.dataset.gen || 'gen1');
                    window.location.href = url.toString();
                };
            });
        }

        document.addEventListener('astro:page-load', init);

        document.addEventListener('favorites-updated', () => {
            const dataEl = document.getElementById('index-data');
            if (dataEl && dataEl.dataset.gen === 'favorites') {
                const lang = dataEl.dataset.lang || 'es';
                const uiTranslations = JSON.parse(dataEl.dataset.translations || '{}');
                const t = uiTranslations[lang] || uiTranslations.es;
                loadFavoritesView(lang, t);
            }
        });
    </script>
</Layout>
